// Function to convert points to array
std::vector<std::array<dfloat, 3>> convertPointsToArrays(const std::vector<Point>& points) {
    std::vector<std::array<dfloat, 3>> arrays;
    for (const auto& point : points) {
        arrays.push_back({point.px, point.py, point.pz});
    }
    return arrays;
}

// Function to extract iso-surface points using VTK (only points not the actual mesh)
std::vector<std::array<dfloat, 3>> extractIsoSurfacePoints(const std::vector<std::array<dfloat, 3>>& myPoints, const std::vector<dfloat>& mySDFValues, const int numX) {
    std::vector<std::array<dfloat, 3>> isoSurfacePoints;


    if (myPoints.empty() || mySDFValues.empty()) {
        // Handle empty input scenario, perhaps by returning an empty result
        return isoSurfacePoints;
    }

    // Create VTK points and scalar array
    vtkSmartPointer<vtkPoints> points = vtkSmartPointer<vtkPoints>::New();
    vtkSmartPointer<vtkFloatArray> sdfArray = vtkSmartPointer<vtkFloatArray>::New();

    // Populate VTK points and scalar array
    for (size_t i = 0; i < myPoints.size(); ++i) {
    double point[3] = {myPoints[i][0], myPoints[i][1], myPoints[i][2]};
    points->InsertNextPoint(point);
    sdfArray->InsertNextValue(static_cast<dfloat>(mySDFValues[i]));
    }


    // Create VTK structured grid
    vtkSmartPointer<vtkStructuredGrid> structuredGrid = vtkSmartPointer<vtkStructuredGrid>::New();
    // numX is the number of points in X direction, which equals the number of points in Y and Z
    int dims[3] =  {numX, numX, numX};

    structuredGrid->SetDimensions(dims); // Assuming dims = {numX, numY, numZ}
    structuredGrid->SetPoints(points);
    structuredGrid->GetPointData()->SetScalars(sdfArray);


    // Perform iso-surface extraction
    vtkSmartPointer<vtkContourFilter> contourFilter = vtkSmartPointer<vtkContourFilter>::New();
    contourFilter->SetInputData(structuredGrid);
    contourFilter->SetValue(0, 0.0); // Extract iso-surface where SDF = 0.0
    contourFilter->Update();

    vtkPolyData* isoSurface = contourFilter->GetOutput();
    vtkPoints* isoPoints = isoSurface->GetPoints();
    if (!isoPoints) {
        std::cerr << "No isoPoints generated." << std::endl;
        return isoSurfacePoints;
    }

    // Extract iso-surface points
    for (vtkIdType i = 0; i < isoPoints->GetNumberOfPoints(); i++) {
        double p[3];
        isoPoints->GetPoint(i, p);
        isoSurfacePoints.push_back({static_cast<dfloat>(p[0]), static_cast<dfloat>(p[1]), static_cast<dfloat>(p[2])});
    }

    return isoSurfacePoints;
}

// Function to extract iso-surface points and normals using VTK.
IsoSurfaceData extractIsoSurfacePointsAndNormals(
    const std::vector<std::array<dfloat, 3>>& myPoints,
    const std::vector<dfloat>& mySDFValues,
    const int numX)
{
    IsoSurfaceData isoData;

    if (myPoints.empty() || mySDFValues.empty()) {
        // Handle empty input scenario: return empty data.
        return isoData;
    }

    // Create VTK points and scalar array.
    vtkSmartPointer<vtkPoints> points = vtkSmartPointer<vtkPoints>::New();
    vtkSmartPointer<vtkFloatArray> sdfArray = vtkSmartPointer<vtkFloatArray>::New();
    sdfArray->SetName("SDF");

    // Populate VTK points and scalar array.
    for (size_t i = 0; i < myPoints.size(); ++i) {
        double point[3] = { myPoints[i][0], myPoints[i][1], myPoints[i][2] };
        points->InsertNextPoint(point);
        sdfArray->InsertNextValue(static_cast<dfloat>(mySDFValues[i]));
    }

    // Create a structured grid.
    vtkSmartPointer<vtkStructuredGrid> structuredGrid = vtkSmartPointer<vtkStructuredGrid>::New();
    int dims[3] = { numX, numX, numX }; // Assumed equal in each direction.
    structuredGrid->SetDimensions(dims);
    structuredGrid->SetPoints(points);
    structuredGrid->GetPointData()->SetScalars(sdfArray);

    // Perform iso-surface extraction using vtkContourFilter.
    vtkSmartPointer<vtkContourFilter> contourFilter = vtkSmartPointer<vtkContourFilter>::New();
    contourFilter->SetInputData(structuredGrid);
    contourFilter->SetValue(0, 0.0); // Extract the zero level-set.
    contourFilter->Update();

    vtkSmartPointer<vtkPolyData> isoSurface = contourFilter->GetOutput();
    if (!isoSurface || !isoSurface->GetPoints()) {
        std::cerr << "No isoSurface points generated." << std::endl;
        return isoData;
    }

    // Compute normals on the iso-surface.
    vtkSmartPointer<vtkPolyDataNormals> normalsFilter = vtkSmartPointer<vtkPolyDataNormals>::New();
    normalsFilter->SetInputData(isoSurface);
    normalsFilter->ComputePointNormalsOn();
    normalsFilter->ConsistencyOn();
    normalsFilter->AutoOrientNormalsOn();
    normalsFilter->Update();

    vtkPolyData* isoSurfaceWithNormals = normalsFilter->GetOutput();
    vtkPoints* isoPoints = isoSurfaceWithNormals->GetPoints();
    vtkDataArray* normalArray = isoSurfaceWithNormals->GetPointData()->GetNormals();

    if (!isoPoints || !normalArray) {
        std::cerr << "No isoSurface points or normals generated." << std::endl;
        return isoData;
    }

    // Extract iso-surface points and normals.
    vtkIdType numIsoPoints = isoPoints->GetNumberOfPoints();
    for (vtkIdType i = 0; i < numIsoPoints; ++i) {
        double p[3];
        isoPoints->GetPoint(i, p);
        isoData.points.push_back({ static_cast<dfloat>(p[0]),
                                     static_cast<dfloat>(p[1]),
                                     static_cast<dfloat>(p[2]) });
        double n[3];
        normalArray->GetTuple(i, n);
        isoData.normals.push_back({ static_cast<dfloat>(n[0]),
                                      static_cast<dfloat>(n[1]),
                                      static_cast<dfloat>(n[2]) });
    }

    return isoData;
}


// Extract an iso-surface mesh (points and faces) from the given structured grid data.
IsoSurfaceMesh extractIsoSurfaceMesh(const std::vector<std::array<dfloat, 3>> &myPoints,
                                      const std::vector<dfloat> &mySDFValues,
                                      const int numX)
{
  IsoSurfaceMesh meshData;

  if (myPoints.empty() || mySDFValues.empty()) {
    // Return empty mesh if no input.
    return meshData;
  }

  // Create VTK points and scalar array.
  vtkSmartPointer<vtkPoints> vtkPts = vtkSmartPointer<vtkPoints>::New();
  vtkSmartPointer<vtkFloatArray> sdfArray = vtkSmartPointer<vtkFloatArray>::New();
  for (size_t i = 0; i < myPoints.size(); ++i) {
    double p[3] = { myPoints[i][0], myPoints[i][1], myPoints[i][2] };
    vtkPts->InsertNextPoint(p);
    sdfArray->InsertNextValue(static_cast<dfloat>(mySDFValues[i]));
  }

  // Create a VTK structured grid.
  vtkSmartPointer<vtkStructuredGrid> structuredGrid = vtkSmartPointer<vtkStructuredGrid>::New();
  int dims[3] = { numX, numX, numX };
  structuredGrid->SetDimensions(dims);
  structuredGrid->SetPoints(vtkPts);
  structuredGrid->GetPointData()->SetScalars(sdfArray);



  // Extract the iso-surface using vtkContourFilter.
  vtkSmartPointer<vtkContourFilter> contourFilter = vtkSmartPointer<vtkContourFilter>::New();
  contourFilter->SetInputData(structuredGrid);
  contourFilter->SetValue(0, 0.0); // Extract the 0 level-set.
  contourFilter->Update();

  vtkPolyData *isoPolyData = contourFilter->GetOutput();
  if (!isoPolyData || !isoPolyData->GetPoints()) {
    std::cerr << "No iso-surface extracted." << std::endl;
    return meshData;
  }

  // Extract iso-surface points.
  vtkPoints *isoPoints = isoPolyData->GetPoints();
  vtkIdType numIsoPoints = isoPoints->GetNumberOfPoints();
  for (vtkIdType i = 0; i < numIsoPoints; ++i) {
    double p[3];
    isoPoints->GetPoint(i, p);
    meshData.points.push_back({ static_cast<dfloat>(p[0]),
                                 static_cast<dfloat>(p[1]),
                                 static_cast<dfloat>(p[2]) });
  }

  // Extract the connectivity (faces) from the iso-surface.
  vtkCellArray *polys = isoPolyData->GetPolys();
  if (polys) {
    polys->InitTraversal();
    vtkIdType npts;
    vtkIdType const* pts = nullptr;
    while (polys->GetNextCell(npts, pts)) {
      if (npts == 3) {  // we are interested in triangles
        meshData.faces.push_back({ static_cast<std::size_t>(pts[0]),
                                    static_cast<std::size_t>(pts[1]),
                                    static_cast<std::size_t>(pts[2]) });
      }
    }
  }

  return meshData;
}

// Convert Cartesian points to std::array<dfloat, 3> for VTK.
std::vector<std::array<dfloat, 3>> convertPointsToArray(const std::vector<Point_3>& points) {
    std::vector<std::array<dfloat, 3>> arrayPoints;
    arrayPoints.reserve(points.size());
    for (const auto& pt : points) {
        arrayPoints.push_back({ pt.x(), pt.y(), pt.z() });
    }
    return arrayPoints;
}

// Adding the stl points to the contour surface (triangulated surface)
IsoSurfaceMesh extractIsoSurfaceMeshPlusSTL(const std::vector<std::array<dfloat, 3>> &myPoints,
                                              const std::vector<dfloat> &mySDFValues,
                                              const std::vector<std::array<dfloat, 3>> &stlPoints,
                                              const int numX)
{
  IsoSurfaceMesh meshData;

  if (myPoints.empty() || mySDFValues.empty()) {
    // Return empty mesh if no structured input.
    return meshData;
  }

  //  Create the structured grid (volume data) as a vtkStructuredGrid and then convert it to polydata.
  vtkSmartPointer<vtkStructuredGrid> structuredGrid = vtkSmartPointer<vtkStructuredGrid>::New();
  int dims[3] = { numX, numX, numX };
  structuredGrid->SetDimensions(dims);

  vtkSmartPointer<vtkPoints> ptsStructured = vtkSmartPointer<vtkPoints>::New();
  vtkSmartPointer<vtkFloatArray> sdfStructured = vtkSmartPointer<vtkFloatArray>::New();
  sdfStructured->SetName("SDF");

  for (size_t i = 0; i < myPoints.size(); ++i) {
    double p[3] = { myPoints[i][0], myPoints[i][1], myPoints[i][2] };
    ptsStructured->InsertNextPoint(p);
    sdfStructured->InsertNextValue(static_cast<float>(mySDFValues[i]));
  }

  structuredGrid->SetPoints(ptsStructured);
  structuredGrid->GetPointData()->SetScalars(sdfStructured);

  // Convert structured grid to polydata.
  vtkSmartPointer<vtkGeometryFilter> geomFilter = vtkSmartPointer<vtkGeometryFilter>::New();
  geomFilter->SetInputData(structuredGrid);
  geomFilter->Update();
  vtkSmartPointer<vtkPolyData> polyDataStructured = geomFilter->GetOutput();

  //  Create polydata from the STL vertices.
  vtkSmartPointer<vtkPoints> ptsSTL = vtkSmartPointer<vtkPoints>::New();
  vtkSmartPointer<vtkFloatArray> sdfSTL = vtkSmartPointer<vtkFloatArray>::New();
  sdfSTL->SetName("SDF");

  for (size_t i = 0; i < stlPoints.size(); ++i) {
    double p[3] = { stlPoints[i][0], stlPoints[i][1], stlPoints[i][2] };
    ptsSTL->InsertNextPoint(p);
    // Since these are on the surface, assign SDF = 0.
    sdfSTL->InsertNextValue(0.0f);
  }

  vtkSmartPointer<vtkPolyData> polyDataSTL = vtkSmartPointer<vtkPolyData>::New();
  polyDataSTL->SetPoints(ptsSTL);
  polyDataSTL->GetPointData()->SetScalars(sdfSTL);

  // Merge the two datasets.
  vtkSmartPointer<vtkAppendPolyData> appendFilter = vtkSmartPointer<vtkAppendPolyData>::New();
  appendFilter->AddInputData(polyDataStructured);
  appendFilter->AddInputData(polyDataSTL);
  appendFilter->Update();

  // Instead, use the raw merged output.
  vtkSmartPointer<vtkPolyData> mergedPolyData = appendFilter->GetOutput();

  // Convert the merged polydata to an unstructured grid via Delaunay3D.
  vtkSmartPointer<vtkDelaunay3D> delaunay = vtkSmartPointer<vtkDelaunay3D>::New();
  delaunay->SetInputData(mergedPolyData);
  delaunay->Update();
  vtkSmartPointer<vtkUnstructuredGrid> uGrid = delaunay->GetOutput();

  // Extract the iso-surface from the unstructured grid.
  vtkSmartPointer<vtkContourFilter> contourFilter = vtkSmartPointer<vtkContourFilter>::New();
  contourFilter->SetInputData(uGrid);
  contourFilter->SetValue(0, 0.0); // iso–value is 0.
  contourFilter->Update();
  vtkPolyData* isoPolyData = contourFilter->GetOutput();

  if (!isoPolyData || !isoPolyData->GetPoints()) {
    std::cerr << "No iso-surface extracted." << std::endl;
    return meshData;
  }

  // Extract iso-surface points.
  vtkPoints *isoPoints = isoPolyData->GetPoints();
  vtkIdType numIsoPoints = isoPoints->GetNumberOfPoints();
  for (vtkIdType i = 0; i < numIsoPoints; ++i) {
    double p[3];
    isoPoints->GetPoint(i, p);
    meshData.points.push_back({ static_cast<dfloat>(p[0]),
                                 static_cast<dfloat>(p[1]),
                                 static_cast<dfloat>(p[2]) });
  }

  // Extract the connectivity (faces) from the iso-surface.
  vtkCellArray *polys = isoPolyData->GetPolys();
  if (polys) {
    polys->InitTraversal();
    vtkIdType npts;
    vtkIdType const* pts = nullptr;
    while (polys->GetNextCell(npts, pts)) {
      if (npts == 3) {  // we are interested in triangles
        meshData.faces.push_back({ static_cast<std::size_t>(pts[0]),
                                    static_cast<std::size_t>(pts[1]),
                                    static_cast<std::size_t>(pts[2]) });
      }
    }
  }

  return meshData;
}


// Disabled CGAL
#if 0
bool isPointOnSurface(const Mesh& triangulatedMesh, const Point_3& queryPoint, dfloat tolerance) {
    if (triangulatedMesh.is_empty()) {
        std::cerr << "Error: The triangulated mesh is empty!" << std::endl;
        return false;
    }

    // Build AABB tree for fast closest-point queries
    AABB_Tree tree(faces(triangulatedMesh).first, faces(triangulatedMesh).second, triangulatedMesh);
    tree.accelerate_distance_queries();

    if (tree.empty()) {
        std::cerr << "Error: AABB tree construction failed (no triangles in mesh)!" << std::endl;
        return false;
    }

    // Find the closest point on the triangulated surface
    Point_3 closestPoint = tree.closest_point(queryPoint);

    // Compute the squared distance
    dfloat squaredDist = CGAL::squared_distance(queryPoint, closestPoint);

    // If the squared distance is within the threshold, the point is on the surface
    return squaredDist < (tolerance * tolerance);
}



// Convert faces (std::array<size_t,3>) to a vector of vectors:
std::vector<std::vector<std::size_t>>
convertFaces(const std::vector<std::array<std::size_t, 3>>& facesArray)
{
  std::vector<std::vector<std::size_t>> faces;
  for (const auto& arr : facesArray) {
    faces.push_back({ arr[0], arr[1], arr[2] });
  }
  return faces;
}


// Used to construct the mesh after finding the contour surface and to use that mesh to determine whether the STL points lie on that mesh of not
Mesh createSurfaceMeshFromPoints(const std::vector<Point_3>& points_const,
                                 const std::vector<std::array<std::size_t, 3>>& faces_array)
{
  // Make a mutable copy of the points
  std::vector<Point_3> points = points_const;
  // Convert faces from std::array to vector form
  std::vector<std::vector<std::size_t>> faces = convertFaces(faces_array);

  // Orient the polygon soup (this may modify the order of points in each face)
  CGAL::Polygon_mesh_processing::orient_polygon_soup(points, faces);

  // Create a surface mesh from the (oriented) polygon soup.
  Mesh mesh;
  CGAL::Polygon_mesh_processing::polygon_soup_to_polygon_mesh(points, faces, mesh);

  std::cout << "Successfully created mesh with " << mesh.number_of_faces() << " faces." << std::endl;
  return mesh;
}
#endif

// Helper function to gather STL vertices from all ranks into a single vector on rank 0
std::vector<Vertex> gatherSTLVertices() {
    int rank, size;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    int localSize = STLvertices.size();
    std::vector<int> allSizes(size);
    MPI_Allgather(&localSize, 1, MPI_INT, allSizes.data(), 1, MPI_INT, MPI_COMM_WORLD);

    // Calculate displacements on all ranks
    std::vector<int> displacements(size, 0);
    int totalSize = allSizes[0];
    for (int i = 1; i < size; ++i) {
        displacements[i] = displacements[i - 1] + allSizes[i - 1];
        totalSize += allSizes[i];
    }

    // Rank 0 allocates space to receive all data
    std::vector<Vertex> globalSTL;
    if (rank == 0) {
        globalSTL.resize(totalSize);
    }

    MPI_Gatherv(STLvertices.data(), localSize * sizeof(Vertex), MPI_BYTE,
                rank == 0 ? globalSTL.data() : nullptr,
                allSizes.data(), displacements.data(),
                MPI_BYTE, 0, MPI_COMM_WORLD);

    return globalSTL; // Only valid on rank 0
}

// Create the triangulated surface, finds the intergration and Lagrangian points, writes the output mesh, makes sure the STL points are on that mesh and computes the area of the traingulated mesh to compare it to the actual STL mesh
void identifyCuttingTrianglesWithIntersections(
    const std::vector<Point>& quadPoints,
    int pointsPerElement,
    const std::vector<Vertex>& vertices,
    const std::vector<FacetNormal>& normals,
    const std::vector<dfloat>& sdfValues)
{

    int p = std::cbrt(pointsPerElement) - 1; // Compute polynomial order

    dfloat threshold = 1e-36; // Threshold value

    // Local lists for this rank
    std::vector<dfloat> xCoords_celem, yCoords_celem, zCoords_celem;
    globalIntegrationPoints.clear();
    globalLagrangePoints.clear();

    std::vector<Point_3> localPoints;
    std::vector<std::array<std::size_t, 3>> localFaces;

    // Loop over all elements
    for (size_t elementIdx = 0; elementIdx < quadPoints.size(); elementIdx += pointsPerElement) {
        std::vector<dfloat> xCoords_E, yCoords_E, zCoords_E;

        auto isUnique = [&xCoords_E, &yCoords_E, &zCoords_E, &threshold](dfloat x, dfloat y, dfloat z) {
            for (size_t i = 0; i < xCoords_E.size(); ++i) {
                if (std::abs(x - xCoords_E[i]) < threshold && std::abs(y - yCoords_E[i]) < threshold && std::abs(z - zCoords_E[i]) < threshold) {
                    return false;
                }
            }
            return true;
        };

        for (int i = 0; i < pointsPerElement; ++i) {
            int idx = elementIdx + i;
            if (sdfValues[idx] == 0) {
                xCoords_E.push_back(quadPoints[idx].px);
                yCoords_E.push_back(quadPoints[idx].py);
                zCoords_E.push_back(quadPoints[idx].pz);
            }
        }

        std::vector<Point> elementQuadPoints(pointsPerElement);
        std::vector<dfloat> elementSdfValues(pointsPerElement);

        for (int i = 0; i < pointsPerElement; ++i) {
            int idx = elementIdx + i;
            elementQuadPoints[i] = quadPoints[idx];
            elementSdfValues[i] = sdfValues[idx];
        }


        std::vector<std::array<dfloat, 3>> convertedElementQuadPoints = convertPointsToArrays(elementQuadPoints);
        int numX = p + 1;

        auto isoSurfacePoints = extractIsoSurfacePoints(convertedElementQuadPoints, elementSdfValues, numX);
        bool isCutElement = !isoSurfacePoints.empty();

        if (isCutElement) {
            dfloat minX = std::numeric_limits<dfloat>::max();
            dfloat maxX = std::numeric_limits<dfloat>::lowest();
            dfloat minY = std::numeric_limits<dfloat>::max();
            dfloat maxY = std::numeric_limits<dfloat>::lowest();
            dfloat minZ = std::numeric_limits<dfloat>::max();
            dfloat maxZ = std::numeric_limits<dfloat>::lowest();

            for (int i = 0; i < pointsPerElement; ++i) {
                int idx = elementIdx + i;
                dfloat x = quadPoints[idx].px;
                dfloat y = quadPoints[idx].py;
                dfloat z = quadPoints[idx].pz;

                minX = std::min(minX, x);
                maxX = std::max(maxX, x);
                minY = std::min(minY, y);
                maxY = std::max(maxY, y);
                minZ = std::min(minZ, z);
                maxZ = std::max(maxZ, z);
            }

            dfloat XedgeMargin = 0.0 * (maxX - minX);
            dfloat YedgeMargin = 0.0 * (maxY - minY);
            dfloat ZedgeMargin = 0.0 * (maxZ - minZ);

            for (const auto& vertex : vertices) {
                bool insideX = (vertex.x > minX + XedgeMargin && vertex.x < maxX - XedgeMargin);  // add margin to add the STL points
                bool insideY = (vertex.y > minY + YedgeMargin && vertex.y < maxY - YedgeMargin);  // add margin to add the STL points
                bool insideZ = (vertex.z > minZ + ZedgeMargin && vertex.z < maxZ - ZedgeMargin);  // add margin to add the STL points

                if (insideX && insideY && insideZ) {
                    if (isUnique(vertex.x, vertex.y, vertex.z)) {
                        xCoords_E.push_back(vertex.x);
                        yCoords_E.push_back(vertex.y);
                        zCoords_E.push_back(vertex.z);
                    }
                }
            }
        }

        std::vector<Point_3> points;
        for (size_t i = 0; i < xCoords_E.size(); ++i) {
            points.push_back(Point_3(xCoords_E[i], yCoords_E[i], zCoords_E[i]));
        }

        // Extract the iso-surface mesh (both points and faces) from the SDF data plus STL vertices
        std::vector<std::array<dfloat, 3>> stlPointsConverted = convertPointsToArray(points);

        // If you want to add the original STL points
        // IsoSurfaceMesh isoMesh = extractIsoSurfaceMeshPlusSTL(convertedElementQuadPoints, elementSdfValues, stlPointsConverted, numX);

        // With no STL points
        IsoSurfaceMesh isoMesh = extractIsoSurfaceMesh(convertedElementQuadPoints, elementSdfValues, numX);

        // Turn this off now and only use isoMesh
        //CGAL::grid_simplify_point_set(points, 0.1);
        //std::vector<std::array<std::size_t, 3>> faces;
        //CGAL::advancing_front_surface_reconstruction(points.begin(), points.end(), std::back_inserter(faces));


        for (const auto &face : isoMesh.faces) {

            Point_3 v1(isoMesh.points[face[0]][0], isoMesh.points[face[0]][1], isoMesh.points[face[0]][2]);
            Point_3 v2(isoMesh.points[face[1]][0], isoMesh.points[face[1]][1], isoMesh.points[face[1]][2]);
            Point_3 v3(isoMesh.points[face[2]][0], isoMesh.points[face[2]][1], isoMesh.points[face[2]][2]);

            auto integrationPoints = computeIntegrationPointsForTriangle(v1, v2, v3);
            auto LagrangePoints    = computeLagrangePointsForTriangle(v1, v2, v3, elementIdx / pointsPerElement);

            globalIntegrationPoints.insert(globalIntegrationPoints.end(), integrationPoints.begin(), integrationPoints.end());
            globalLagrangePoints.insert(globalLagrangePoints.end(), LagrangePoints.begin(), LagrangePoints.end());
        }

        // Adjust face indices
        // Compute offset for the current element.
        size_t offset = localPoints.size();
        // Append the points from this element.
        for (const auto& pt : isoMesh.points) {
            localPoints.push_back(Point_3(pt[0], pt[1], pt[2]));
        }

        // Adjust each face index and then append the faces.
        for (auto& face : isoMesh.faces) {
            face[0] += offset;
            face[1] += offset;
            face[2] += offset;
            localFaces.push_back(face);
        }
    }

     // Initialize MPI if not already initialized
    int initialized;
    MPI_Initialized(&initialized);
    if (!initialized) {
        MPI_Init(NULL, NULL);
    }

    int rank, size;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    //Adjust Face Indices
    // The face indices in localFaces are relative to localPoints.
    // To create a consistent global mesh, each rank's face indices must be offset
    // by the total number of points from all lower-ranked processes.

    // Get the number of local points
    int localNumPoints = localPoints.size();

    // Gather the number of points from all processes
    std::vector<int> allLocalNumPoints(size);
    MPI_Allgather(&localNumPoints, 1, MPI_INT, allLocalNumPoints.data(), 1, MPI_INT, MPI_COMM_WORLD);

    // Compute the offset for the current rank
    int pointOffset = 0;
    for (int i = 0; i < rank; ++i) {
        pointOffset += allLocalNumPoints[i];
    }

    // Adjust each local face by adding the point offset
    for (auto &face : localFaces) {
        face[0] += pointOffset;
        face[1] += pointOffset;
        face[2] += pointOffset;
    }

    // === Step 1: Gather All Points and Faces ===
    std::vector<Point_3> globalPoints;
    std::vector<std::array<std::size_t, 3>> globalFaces;

    int localNumFaces = localFaces.size();

    // Gather the number of points and faces from all ranks (as element counts)
    std::vector<int> allNumPoints(size), allNumFaces(size);
    MPI_Gather(&localNumPoints, 1, MPI_INT, allNumPoints.data(), 1, MPI_INT, 0, MPI_COMM_WORLD);
    MPI_Gather(&localNumFaces,   1, MPI_INT, allNumFaces.data(),   1, MPI_INT, 0, MPI_COMM_WORLD);

    // Prepare arrays for MPI_Gatherv counts and displacements (on rank 0)
    std::vector<int> recvCountsPoints;
    std::vector<int> recvCountsFaces;
    std::vector<int> pointDisplacements(size, 0), faceDisplacements(size, 0);

    if (rank == 0) { // rank 0 does the conversion
        recvCountsPoints.resize(size);
        recvCountsFaces.resize(size);
        int totalBytesPoints = 0;
        int totalBytesFaces = 0;
        for (int i = 0; i < size; ++i) {
            // Convert element counts to byte counts
            recvCountsPoints[i] = allNumPoints[i] * sizeof(Point_3);
            recvCountsFaces[i]  = allNumFaces[i]  * sizeof(std::array<std::size_t, 3>);
            if (i > 0) {
                pointDisplacements[i] = pointDisplacements[i-1] + recvCountsPoints[i-1];
                faceDisplacements[i]  = faceDisplacements[i-1]  + recvCountsFaces[i-1];
            }
            totalBytesPoints += recvCountsPoints[i];
            totalBytesFaces  += recvCountsFaces[i];
        }
        // Resize global vectors to hold all the data
        globalPoints.resize(totalBytesPoints / sizeof(Point_3));
        globalFaces.resize(totalBytesFaces / sizeof(std::array<std::size_t, 3>));
    }

    //  Gather Data Using MPI_Gatherv with MPI_BYTE
    MPI_Gatherv(localPoints.data(),
                localNumPoints * sizeof(Point_3), MPI_BYTE,
                globalPoints.data(),
                (rank == 0 ? recvCountsPoints.data() : nullptr),
                (rank == 0 ? pointDisplacements.data() : nullptr),
                MPI_BYTE, 0, MPI_COMM_WORLD);

    MPI_Gatherv(localFaces.data(),
                localNumFaces * sizeof(std::array<std::size_t, 3>), MPI_BYTE,
                globalFaces.data(),
                (rank == 0 ? recvCountsFaces.data() : nullptr),
                (rank == 0 ? faceDisplacements.data() : nullptr),
                MPI_BYTE, 0, MPI_COMM_WORLD);

    //  Write to VTK on Rank 0
    if (rank == 0) {
        // Write the VTK file for the reconstructed mesh
        writeSurfaceMeshToVTK("surface_mesh.vtk", globalPoints, globalFaces);

        // The former CGAL mesh reconstruction was used only by the disabled
        // point-on-surface diagnostic below.  The active workflow already has
        // the VTK iso-surface in globalPoints/globalFaces and writes it above.

        // Count how many STL vertices are "on" (within tolerance) the surface.
        // This CGAL remains disabled.
        // int countOn = 0, countOff = 0;
        // for (const auto& vertex : STLvertices) {
        //     Point_3 queryPoint(vertex.x, vertex.y, vertex.z);
        //     if (isPointOnSurface(reconstructedMesh, queryPoint, 1e-4))
        //         countOn++;
        //     else
        //         countOff++;
        // }
        // std::cout << "Number of STL points on surface: " << countOn << std::endl;
        // std::cout << "Number of STL points NOT on surface: " << countOff << std::endl;
    }

    // Gather globalLagrangePoints from all ranks to rank 0
    int localLagrangeCount = globalLagrangePoints.size();
    std::vector<int> allLagrangeCounts(size);
    MPI_Allgather(&localLagrangeCount, 1, MPI_INT, allLagrangeCounts.data(), 1, MPI_INT, MPI_COMM_WORLD);

    // Compute displacements and total count
    std::vector<int> lagrangeDisplacements(size, 0);
    int totalLagrangeCount = allLagrangeCounts[0];
    for (int i = 1; i < size; ++i) {
        lagrangeDisplacements[i] = lagrangeDisplacements[i - 1] + allLagrangeCounts[i - 1];
        totalLagrangeCount += allLagrangeCounts[i];
    }

    // Prepare receive buffer on rank 0
    std::vector<LagrangePoint> gatheredLagrangePoints;
    if (rank == 0) {
        gatheredLagrangePoints.resize(totalLagrangeCount);
    }

    std::vector<int> byteCounts(size);
    std::vector<int> byteDisplacements(size);
    for (int i = 0; i < size; ++i) {
        byteCounts[i] = allLagrangeCounts[i] * sizeof(LagrangePoint);
        byteDisplacements[i] = lagrangeDisplacements[i] * sizeof(LagrangePoint);
    }

    // Use MPI_Gatherv to gather the struct as raw bytes
    MPI_Gatherv(globalLagrangePoints.data(), localLagrangeCount * sizeof(LagrangePoint), MPI_BYTE,
                rank == 0 ? gatheredLagrangePoints.data() : nullptr,
                byteCounts.data(), byteDisplacements.data(),
                MPI_BYTE, 0, MPI_COMM_WORLD);


    // Rank 0 computes triangulated area from all Lagrange points
    if (rank == 0) {
        dfloat triangulatedArea = 0.0;
        for (const auto& iL : gatheredLagrangePoints) {
            triangulatedArea += iL.weight;
        }

        // Compute the area of the STL surface
        dfloat stlSurfaceArea = computeSTLSurfaceArea(STLvertices);

        // Compute the absolute and relative differences
        dfloat absoluteDifference = std::fabs(triangulatedArea - stlSurfaceArea);
        dfloat relativeDifference = absoluteDifference / stlSurfaceArea;

        // Output the results
        std::cout << "STL Surface Area: " << stlSurfaceArea << std::endl;
        std::cout << "Triangulated Surface Area: " << triangulatedArea << std::endl;
        std::cout << "Absolute Difference: " << absoluteDifference << std::endl;
        std::cout << "Relative Difference: " << relativeDifference * 100.0 << " %" << std::endl;
    }
//
    if (!initialized) {
        MPI_Finalize();
    }
}

// Main Function
int main2() {
    // Parse the STL file
    if (parse_stl(kSTLFile, STLvertices, STLnormals)) {
        const std::vector<Point>& testPoints = quad_points;

        // Classify points using VTK
        std::vector<double> distances = classifyPointsWithVTK(quad_points, kSTLFile);

        //Classify using EMBREE
        // std::vector<double> distances = classifyPointsWithEMBREE(quad_points, kSTLFile);

        sdfValues.resize(quad_points.size());
        for (size_t i = 0; i < quad_points.size(); ++i) {
            sdfValues[i] = static_cast<dfloat>(distances[i]);
        }

        // Call the function to identify cutting triangles with intersections
        identifyCuttingTrianglesWithIntersections(quad_points, QuadPointsPerElement, STLvertices, STLnormals, sdfValues);

        return 0; // Indicate successful execution
    } else {
        std::cerr << "Parsing failed." << std::endl;
        return 1; // Indicate failure
    }
}
