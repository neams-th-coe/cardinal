std::vector<Point> globalPoints; // All Immersed surface points
std::vector<std::array<std::size_t, 3>> globalFaces;   // All Immersed surface faces

// Define a global variable to hold the integrationPoints
std::vector<IntegrationPoint> globalIntegrationPoints;
std::vector<LagrangePoint> globalLagrangePoints;

// Lagrange points on this rank
std::vector<LagrangePoint> localLagrangePoints;

std::vector<Vertex> STLvertices;  // Declare vertices as a global variable
std::vector<FacetNormal> STLnormals;  // Declare normals as global

// declare user-defined device kernel
static deviceKernel PenaltyNoSlipBCKernel;
static deviceKernel viscosityKernel;
