// Parsing STL file
bool try_parse_float(const std::string& token, dfloat& value) {
    try {
        size_t pos;
        value = std::stof(token, &pos);
        return pos == token.size();
    } catch (...) {
        return false;
    }
}


// Helper functions to perform vector operations
Vector vectorSubtract(const Vertex& a, const Vertex& b) {
    return {a.x - b.x, a.y - b.y, a.z - b.z};
}

// Dot product function
dfloat Dot(const Vector& vector1, const Vector& vector2) {
    return vector1.vx * vector2.vx + vector1.vy * vector2.vy + vector1.vz * vector2.vz;
}

Vector crossProduct(const Vector& a, const Vector& b) {
    return {
        a.vy * b.vz - a.vz * b.vy,
        a.vz * b.vx - a.vx * b.vz,
        a.vx * b.vy - a.vy * b.vx
    };
}

dfloat magnitude(const Vector& v) {
    return std::sqrt(v.vx * v.vx + v.vy * v.vy + v.vz * v.vz);
}

Vector normalize(const Vector& v) {
    dfloat mag = magnitude(v);
    return {v.vx / mag, v.vy / mag, v.vz / mag};
}


// Parse STL file (read vertices and normals)
bool parse_stl(const std::string& filename, std::vector<Vertex>& vertices, std::vector<FacetNormal>& normals) {
    std::ifstream file(filename);
    if (!file.is_open()) {
        std::cerr << "Error opening file: " << filename << std::endl;
        return false;
    }

    std::string line;
    std::string ignore;

    while (std::getline(file, line)) {
        std::istringstream iss(line);
        iss >> ignore;

        if (ignore == "vertex") {
            // Parse vertex coordinates
            Vertex vertex;
            for (int i = 0; i < 3; ++i) {
                std::string token;
                iss >> token;
                if (!try_parse_float(token, i == 0 ? vertex.x : (i == 1 ? vertex.y : vertex.z))) {
                    std::cerr << "Error parsing vertex coordinates." << std::endl;
                    return false;
                }
            }
            vertices.push_back(vertex);
        } else if (ignore == "facet") {
            // Parse facet normal
            FacetNormal normal;
            iss >> ignore >> normal.nx >> normal.ny >> normal.nz;
            normals.push_back(normal);
        }
    }

    return true;
}

// --------------------------------------
// Functions to manually compute SDF
// --------------------------------------
// Compute the signed distance from a point to a plane defined by normal and distance
// In this approach, when the SDF is positive, it means that the point is outside Omega
dfloat signed_distance_to_plane(const Point& point, const Vertex& v0, const Vertex& v1, const Vertex& v2, FacetNormal& normal) {
    dfloat distance = normal.nx * v0.x + normal.ny * v0.y + normal.nz * v0.z;
    return (  (normal.nx * point.px + normal.ny * point.py + normal.nz * point.pz - distance) /
            (std::sqrt(normal.nx * normal.nx + normal.ny * normal.ny + normal.nz * normal.nz)) );
}


// Project a point onto a plane
Point projectPointOnPlane(const Point& point, const Vertex& v0, const Vertex& v1, const Vertex& v2, FacetNormal& Normal) {
    dfloat distance = signed_distance_to_plane(point, v0, v1, v2, Normal);
    Vector normal = crossProduct(vectorSubtract(v1, v0), vectorSubtract(v2, v0));
    normal = normalize(normal);
    return {point.px - normal.vx * distance, point.py - normal.vy * distance, point.pz - normal.vz * distance};
}

// Check if a point is inside a triangle
bool pointInTriangle(const Point& p, const Vertex& v0, const Vertex& v1, const Vertex& v2) {
    Vector v00 = vectorSubtract(v2, v0);
    Vector v11 = vectorSubtract(v1, v0);
    Vector v22 = vectorSubtract({p.px, p.py, p.pz}, v0);

    dfloat dot00 = Dot(v00, v00);
    dfloat dot01 = Dot(v00, v11);
    dfloat dot02 = Dot(v00, v22);
    dfloat dot11 = Dot(v11, v11);
    dfloat dot12 = Dot(v11, v22);

    dfloat invDenom = 1 / (dot00 * dot11 - dot01 * dot01);
    dfloat u = (dot11 * dot02 - dot01 * dot12) * invDenom;
    dfloat v = (dot00 * dot12 - dot01 * dot02) * invDenom;

    return (u >= 0) && (v >= 0) && (u + v <= 1);
}

// Distance from a point to a line segment
dfloat pointToLineSegmentDistance(const Point& p, const Vertex& a, const Vertex& b) {
    Vector ap = {p.px - a.x, p.py - a.y, p.pz - a.z};
    Vector ab = {b.x - a.x, b.y - a.y, b.z - a.z};
    dfloat abSquare = Dot(ab, ab);
    dfloat apDotAb = Dot(ap, ab);
    dfloat t = apDotAb / abSquare;
    t = std::max(0.0, std::min(1.0, t));
    Vertex closest = {a.x + ab.vx * t, a.y + ab.vy * t, a.z + ab.vz * t};
    Vector closestVec = {p.px - closest.x, p.py - closest.y, p.pz - closest.z};
    return magnitude(closestVec);
}

// Signed distance from a point to a triangle
dfloat signedDistanceToTriangle(const Point& p, const Vertex& v0, const Vertex& v1, const Vertex& v2, FacetNormal& Normal) {
    Point projectedPoint = projectPointOnPlane(p, v0, v1, v2, Normal);
    if (pointInTriangle(projectedPoint, v0,v1,v2)) {
        return signed_distance_to_plane(p, v0,v1,v2, Normal);
    } else {
        dfloat d1 = pointToLineSegmentDistance(p, v0, v1);
        dfloat d2 = pointToLineSegmentDistance(p, v1, v2);
        dfloat d3 = pointToLineSegmentDistance(p, v2, v0);
        return std::min({d1, d2, d3});
    }
}


// Compute the signed distance from a point to all triangles
dfloat signedDistanceToTriangles(const std::vector<dfloat>& sdfVector) {
    dfloat minDistance = std::numeric_limits<dfloat>::infinity();

    for (const dfloat& sdf : sdfVector) {
        if (std::abs(sdf) < std::abs(minDistance)) {
            minDistance = sdf;
        }
    }

    return minDistance;
}


dfloat intersectionSDF(const std::vector<dfloat>& sdfVector) {
    if (sdfVector.empty()) {
        return std::numeric_limits<dfloat>::infinity();
    }

    dfloat maxNegativeDistance = -std::numeric_limits<dfloat>::infinity();
    bool allInside = true;
    bool hasValidValues = false;

    for (const dfloat& sdf : sdfVector) {
        if (std::isnan(sdf)) continue; // Skip NaN values

        hasValidValues = true; // Mark that we have at least one valid value

        if (sdf > 0.0f) {
            allInside = false;
            break;
        }
        maxNegativeDistance = std::max(maxNegativeDistance, sdf);
    }

    if (!hasValidValues) return std::numeric_limits<dfloat>::quiet_NaN(); // Return NaN if all values were NaN

    if (allInside) {
        return maxNegativeDistance;
    } else {
        dfloat minPositiveDistance = std::numeric_limits<dfloat>::infinity();
        for (const dfloat& sdf : sdfVector) {
            if (sdf > 0.0f && !std::isnan(sdf)) {
                minPositiveDistance = std::min(minPositiveDistance, sdf);
            }
        }
        return minPositiveDistance;
    }
}

// --------------------------------------
// End of Functions that manually compute SDF
// --------------------------------------

// --------------------------------------
// Computing intersection points manually
// --------------------------------------

// Check if two line segments intersect in 3D (Not needed here)
bool doLineSegmentsIntersect(const Point& p1, const Point& p2, const Point& q1, const Point& q2) {
    std::vector<Point> pPoints = {p1, p2};
    std::vector<Point> qPoints = {q1, q2};

    // Check for intersections between each pair of line segments
    for (int i = 0; i < 2; ++i) {
        for (int j = 0; j < 2; ++j) {
            Point p1 = pPoints[i];
            Point p2 = pPoints[(i + 1) % 2];
            Point q1 = qPoints[j];
            Point q2 = qPoints[(j + 1) % 2];

            dfloat dx1 = p2.px - p1.px;
            dfloat dy1 = p2.py - p1.py;
            dfloat dz1 = p2.pz - p1.pz;

            dfloat dx2 = q2.px - q1.px;
            dfloat dy2 = q2.py - q1.py;
            dfloat dz2 = q2.pz - q1.pz;

            // Compute the cross product of the direction vectors
            dfloat crossx = dy1 * dz2 - dz1 * dy2;
            dfloat crossy = dz1 * dx2 - dx1 * dz2;
            dfloat crossz = dx1 * dy2 - dy1 * dx2;

            dfloat cross_norm = std::sqrt(crossx * crossx + crossy * crossy + crossz * crossz);

            if (std::abs(cross_norm) < 1e-6) {
                continue;  // Line segments are parallel, check the next pair
            }

            dfloat t1 = ((q1.px - p1.px) * crossx + (q1.py - p1.py) * crossy + (q1.pz - p1.pz) * crossz) / cross_norm;
            dfloat t2 = ((q1.px - p1.px) * dx1 + (q1.py - p1.py) * dy1 + (q1.pz - p1.pz) * dz1) / (dx1 * dx1 + dy1 * dy1 + dz1 * dz1);

            if (t1 >= 0.0 && t1 <= 1.0 && t2 >= 0.0 && t2 <= 1.0) {
                return true;  // Intersection found
            }
        }
    }

    return false;  // No intersection found between any pair of line segments
}

// Function to calculate the intersection of a line segment with another line segment (Not needed here)
bool findLineSegmentIntersection(const Point& p1, const Point& p2, const Point& q1, const Point& q2, Point& intersectionPoint) {
    Point r = {p2.px - p1.px, p2.py - p1.py, p2.pz - p1.pz}; // Direction vector of the first line segment
    Point s = {q2.px - q1.px, q2.py - q1.py, q2.pz - q1.pz}; // Direction vector of the second line segment

    Point qp = {q1.px - p1.px, q1.py - p1.py, q1.pz - p1.pz}; // Vector from p1 to q1
    dfloat rxs = r.px * s.pz - r.pz * s.py + r.py * s.px - r.px * s.py + r.pz * s.px - r.py * s.pz; // Cross product of r and s
    dfloat qpxr = qp.px * r.pz - qp.pz * r.py + qp.py * r.px - qp.px * r.py + qp.pz * r.px - qp.py * r.pz; // Cross product of qp and r

    // If r x s = 0 and (q - p) x r = 0, the segments are collinear.
    if (std::abs(rxs) < std::numeric_limits<dfloat>::epsilon() && std::abs(qpxr) < std::numeric_limits<dfloat>::epsilon()) {
        // To handle collinear segments, additional checks for overlap are required.
        return false; // This example will not handle the collinear case.
    }

    // If r x s = 0 and (q - p) x r != 0, then the segments are parallel and non-intersecting.
    if (std::abs(rxs) < std::numeric_limits<dfloat>::epsilon()) return false;

    dfloat t = (qp.px * s.pz - qp.pz * s.py + qp.py * s.px - qp.px * s.py + qp.pz * s.px - qp.py * s.pz) / rxs;
    dfloat u = (qp.px * r.pz - qp.pz * r.py + qp.py * r.px - qp.px * r.py + qp.pz * r.px - qp.py * r.pz) / rxs;

    // If 0 <= t <= 1 and 0 <= u <= 1, the line segments meet at the point p + t r = q + u s.
    if ((0 <= t && t <= 1) && (0 <= u && u <= 1)) {
        // Intersection point is at p1 + t * r.
        intersectionPoint.px = p1.px + t * r.px;
        intersectionPoint.py = p1.py + t * r.py;
        intersectionPoint.pz = p1.pz + t * r.pz;
        return true; // The segments intersect.
    }

    return false; // The segments do not intersect.
}

// Function to calculate the intersection of a line segment with a plane (Not needed here)
Point lineSegmentPlaneIntersection(const Point& p1, const Point& p2, const Vertex& v0, const FacetNormal& normal) {
    Point intersection;

    // Convert Points to Vectors for arithmetic operations
    Vector lineVec = {p2.px - p1.px, p2.py - p1.py, p2.pz - p1.pz};
    Vector v0p1 = {v0.x - p1.px, v0.y - p1.py, v0.z - p1.pz};

    // Calculate dot products for the numerator and denominator of the intersection formula
    dfloat dotNumerator = normal.nx * v0p1.vx + normal.ny * v0p1.vy + normal.nz * v0p1.vz;
    dfloat dotDenominator = normal.nx * lineVec.vx + normal.ny * lineVec.vy + normal.nz * lineVec.vz;

    // Check if the line is parallel to the plane
    if (std::fabs(dotDenominator) < std::numeric_limits<dfloat>::epsilon()) {
        // Return a special value to indicate no intersection
        intersection.px = std::numeric_limits<dfloat>::quiet_NaN();
        intersection.py = std::numeric_limits<dfloat>::quiet_NaN();
        intersection.pz = std::numeric_limits<dfloat>::quiet_NaN();
        return intersection;
    }

    // Calculate the scalar t for the intersection point on the line
    dfloat t = dotNumerator / dotDenominator;

    // Ensure t is within the bounds of the line segment
    if (t >= 0.0 && t <= 1.0) {
        intersection.px = p1.px + t * lineVec.vx;
        intersection.py = p1.py + t * lineVec.vy;
        intersection.pz = p1.pz + t * lineVec.vz;
    } else {
        // Return a special value to indicate no intersection
        intersection.px = std::numeric_limits<dfloat>::quiet_NaN();
        intersection.py = std::numeric_limits<dfloat>::quiet_NaN();
        intersection.pz = std::numeric_limits<dfloat>::quiet_NaN();
    }

    return intersection;
}

// --------------------------------------
// End of computing intersection points manually
// --------------------------------------

