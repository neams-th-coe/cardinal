void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
    // "PenaltyNoSlipBC" is the name in the .oudf file
    // BC
    PenaltyNoSlipBCKernel = oudfBuildKernel(kernelInfo , "PenaltyNoSlipBC");

    // Viscosity
    viscosityKernel = oudfBuildKernel(kernelInfo, "viscosity");
}

void UDF_Setup()
{

    auto mesh = nrs->meshV;
    int n_gll_points = mesh->Np * mesh->Nelements;

    // kernel for adding the BC as a force
    nrs->userSource = &PenaltyNoSlipBCCustomSource;

    // kernel for changing the visosity
    nrs->userProperties = &material_props;


    int Nelements = mesh->Nelements;
    std::cout << "Number of elements "  << Nelements << std::endl;

    QuadPointsPerElement = mesh->Np;

    // Initialize quad_points and velocity initial condition

    if (quad_points.empty())
    {
        quad_points.resize(n_gll_points);

        std::vector<dfloat> x(n_gll_points), y(n_gll_points), z(n_gll_points);
        mesh->o_x.copyTo(x.data());
        mesh->o_y.copyTo(y.data());
        mesh->o_z.copyTo(z.data());

        std::vector<dfloat> U(mesh->dim * nrs->fluid->fieldOffset, 0.0);

        for (int n = 0; n < n_gll_points; ++n)
        {
            U[n + 0 * nrs->fluid->fieldOffset] = 0.0;  // x-velocity
            U[n + 1 * nrs->fluid->fieldOffset] = 0.0;  // y-velocity
            U[n + 2 * nrs->fluid->fieldOffset] = 1.0;  // z-velocity

            quad_points[n].px = x[n];
            quad_points[n].py = y[n];
            quad_points[n].pz = z[n];
        }

        nrs->fluid->o_solution().copyFrom(U.data(), U.size());

    }

     main2(); // Call main2 after quad_points

}



// Function to compute the area of a triangle given its vertices (used to compute the area of the traingulated surface, STL surface, and weight of Lagrangian and integration points)
dfloat computeTriangleArea(const Point_3& v1, const Point_3& v2, const Point_3& v3) {
    const dfloat ax = v2.x() - v1.x();
    const dfloat ay = v2.y() - v1.y();
    const dfloat az = v2.z() - v1.z();
    const dfloat bx = v3.x() - v1.x();
    const dfloat by = v3.y() - v1.y();
    const dfloat bz = v3.z() - v1.z();

    const dfloat crossX = ay * bz - az * by;
    const dfloat crossY = az * bx - ax * bz;
    const dfloat crossZ = ax * by - ay * bx;

    return 0.5 * std::sqrt(crossX * crossX +
                           crossY * crossY +
                           crossZ * crossZ);
}

// Function to compute the total surface area of the STL file
dfloat computeSTLSurfaceArea(const std::vector<Vertex>& vertices) {
    dfloat totalArea = 0.0;

    // Ensure the STL file contains triangles (3 vertices per face)
    if (vertices.size() % 3 != 0) {
        std::cerr << "Error: STL file does not contain a valid set of triangles!" << std::endl;
        return 0.0;
    }

    // Iterate over the triangles in the STL file
    for (size_t i = 0; i < vertices.size(); i += 3) {
        // Extract the three vertices of the triangle
        const Vertex& v1 = vertices[i];
        const Vertex& v2 = vertices[i + 1];
        const Vertex& v3 = vertices[i + 2];

        // Compute the area of the triangle
        dfloat area = computeTriangleArea(Point_3(v1.x, v1.y, v1.z),
                                          Point_3(v2.x, v2.y, v2.z),
                                          Point_3(v3.x, v3.y, v3.z));

        // Accumulate the total area
        totalArea += area;
    }

    return totalArea;
}


void UDF_ExecuteStep(double time, int tstep)
{
    auto mesh = nrs->meshV;
    int n_gll_points = mesh->Np * mesh->Nelements;

    // copy the previous value of the velocity
    o_U_prev = nrs->fluid->o_U;


    if (tstep == 20000) {

      int dataSize = n_gll_points;

      occa::memory o_sdfValues = platform->device.malloc(dataSize * sizeof(dfloat));


     // Copy sdfValues from host to device
       o_sdfValues.copyFrom(sdfValues.data());

        // visualization
       std::string suffix = "sdf";
       int outXYZ = 1;
       int FP64 = 1;

       // writeFld(suffix, time, tstep, outXYZ, FP64,  &o_sdfValues , 1);


       // Setup for numerical integration
       // 1- The function being integrated is f(x,y,z) = x^2+y^2+z^2
       // 2- The function being integrated is f(x,y,z) = e−(x2+y2+z2)
       // 3- The function being integrated is f(x,y,z) = e(−2(x2+y2+z2))
        dfloat integratedValue = 0.0; // This will hold the result of the numerical integration

        // Use globalIntegrationPoints
        for (const auto& ip : globalIntegrationPoints) {
            // Calculate the function value at the integration point
            // dfloat fValue = std::pow(ip.position.x(), 2) + std::pow(ip.position.y(), 2) + std::pow(ip.position.z(), 2);
            // dfloat fValue = std::exp(-(std::pow(ip.position.x(), 2) + std::pow(ip.position.y(), 2) + std::pow(ip.position.z(), 2)));
            dfloat fValue = (std::pow(ip.position.x(), 2) + std::pow(ip.position.y(), 2) + std::pow(ip.position.z(), 2)) *  std::exp(-2 * (std::pow(ip.position.x(), 2) + std::pow(ip.position.y(), 2) + std::pow(ip.position.z(), 2)));


            // Multiply by the weight of the integration point and accumulate
            integratedValue += fValue * ip.weight;
        }

        // Output the result of the numerical integration
        std::cout << "Integrated value of f(x,y,z) over the surface: " << integratedValue << std::endl;
    }

    nrs->copyToNek(time, tstep);
    nek::userchk();


    // Velocity at the Lagrange Points after updating the velocity after the force, MPI is used for Ranks > 1
    if (tstep == 50000) {
        // Check if MPI is already initialized
        int initialized;
        MPI_Initialized(&initialized);
        if (!initialized) {
            MPI_Init(NULL, NULL);
        }

        // Determine rank and size
        int rank, size;
        MPI_Comm_rank(MPI_COMM_WORLD, &rank);
        MPI_Comm_size(MPI_COMM_WORLD, &size);


        // Delete the file if it exists to ensure overwriting
        if (rank == 0) {
            std::remove("uL_values_readable.txt");
        }

        // Number of Lagrange Points on this rank
        size_t numLagrangePoints = globalLagrangePoints.size();

        // Convert Lagrange z point velocities to a string format for each rank
        std::ostringstream localBuffer;
        for (size_t i = 0; i < numLagrangePoints; ++i) {
            localBuffer << std::setprecision(6)
                        <<  uL_host[i + 2 * numLagrangePoints] << "\n";                    // z-velocity
        }


        // Convert the stringstream to a standard string to get the size
        std::string localData = localBuffer.str();
        size_t localDataSize = localData.size();

        // Gather all sizes to calculate the global offset for each rank
        std::vector<size_t> allDataSizes(size);
        MPI_Allgather(&localDataSize, 1, MPI_UNSIGNED_LONG, allDataSizes.data(), 1, MPI_UNSIGNED_LONG, MPI_COMM_WORLD);

        // Calculate offsets for each rank
        std::vector<MPI_Offset> offsets(size);
        offsets[0] = 0;
        for (int i = 1; i < size; ++i) {
            offsets[i] = offsets[i - 1] + allDataSizes[i - 1];
        }

        // Open the file using MPI-IO without truncation mode (file already deleted if exists)
        MPI_File fh;
        MPI_File_open(MPI_COMM_WORLD, "uL_values_readable.txt", MPI_MODE_CREATE | MPI_MODE_WRONLY, MPI_INFO_NULL, &fh);

        // Set the view for each rank to write at its calculated offset
        MPI_File_set_view(fh, offsets[rank], MPI_CHAR, MPI_CHAR, "native", MPI_INFO_NULL);

        // Write the local data
        MPI_File_write(fh, localData.c_str(), localDataSize, MPI_CHAR, MPI_STATUS_IGNORE);

        // Close the file
        MPI_File_close(&fh);

        // Print confirmation from rank 0
        if (rank == 0) {
            std::cout << "Lagrange velocities and positions successfully written to uL_values_readable.txt by all ranks." << std::endl;
        }

        // Finalize MPI if it was initialized here
        if (!initialized) {
            MPI_Finalize();
        }
    }

}
