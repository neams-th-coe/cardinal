    std::vector<dfloat> xL(numIntegrationPoints), yL(numIntegrationPoints), zL(numIntegrationPoints), nLx(numIntegrationPoints), nLy(numIntegrationPoints), nLz(numIntegrationPoints), wL(numIntegrationPoints), LL(numIntegrationPoints);
    for (size_t i = 0; i < numIntegrationPoints; ++i) {
