struct Point_3 {
    dfloat xValue = 0.0;
    dfloat yValue = 0.0;
    dfloat zValue = 0.0;

    Point_3() = default;
    Point_3(dfloat x, dfloat y, dfloat z) : xValue(x), yValue(y), zValue(z) {}

    dfloat x() const { return xValue; }
    dfloat y() const { return yValue; }
    dfloat z() const { return zValue; }
};

static_assert(std::is_trivially_copyable<Point_3>::value,
              "Point_3 remain copyable for MPI_BYTE gathers");


struct Vertex {
    dfloat x, y, z;
};

struct Vector {
    dfloat vx, vy, vz;
};

struct FacetNormal {
    dfloat nx, ny, nz;
};

struct Point {
    dfloat px, py, pz;
};

struct Triangle {
    Vertex v0, v1, v2;
};

// A structure to hold an integration point and its weight
struct IntegrationPoint {
    Point_3 position;
    dfloat weight;
    std::array<dfloat, 3> normal;  // normal
};

// A structure to hold a Lagrange point, its weight, the characteristicArea, characteristicLength, the element number it cuts
struct LagrangePoint {
    Point_3 position;
    dfloat weight;
    dfloat characteristicArea;
    dfloat characteristicLength;
    int elementNumber; //  field to store the element number
    std::array<dfloat, 3> normal;  // normal
};

// Structure to hold iso-surface data: points and normals.
struct IsoSurfaceData {
  std::vector<std::array<dfloat, 3>> points;
  std::vector<std::array<dfloat, 3>> normals;
};

// Define a structure to hold an iso-surface mesh (points and triangle connectivity)
struct IsoSurfaceMesh {
  std::vector<std::array<dfloat, 3>> points;
  std::vector<std::array<std::size_t, 3>> faces;
};


std::vector<Point_3> globalPoints; // All Immersed surface points
std::vector<std::array<std::size_t, 3>> globalFaces;   // All Immersed surface faces


// Define a global variable to hold the integrationPoints
std::vector<IntegrationPoint> globalIntegrationPoints;

// Define a global variable to hold the LagrangePoints
std::vector<LagrangePoint> globalLagrangePoints;

std::vector<Vertex> STLvertices;  // Declare vertices as a global variable
std::vector<FacetNormal> STLnormals;  // Declare normals as global


// declare user-defined device kernel
static deviceKernel PenaltyNoSlipBCKernel;
static deviceKernel viscosityKernel;

