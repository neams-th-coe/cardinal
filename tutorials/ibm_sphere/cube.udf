// Signed distance field values
static std::vector<dfloat> sdfValues;

// Vectors to hold the Lagrange velocities values on the host
static std::vector<dfloat> uL_host;

// Temperature heat flux correction term
void CHTKernelHeatSource(double time)
{
   auto mesh = nrs->meshV;
   auto o_S  = nrs->scalar->o_solution("temperature");
   auto o_FS = nrs->scalar->o_EXT;

    size_t numLagrangePoints = localLagrangePoints.size();

    std::vector<dfloat> xLagrange(numLagrangePoints), yLagrange(numLagrangePoints), zLagrange(numLagrangePoints);
    std::vector<dfloat> characteristicArea(numLagrangePoints), Area(numLagrangePoints), characteristicLength(numLagrangePoints);
    std::vector<int>   ElementNumber(numLagrangePoints);
    std::vector<dfloat> normal_x(numLagrangePoints), normal_y(numLagrangePoints), normal_z(numLagrangePoints);

    for (size_t i = 0; i < numLagrangePoints; ++i)
    {
        xLagrange[i] = localLagrangePoints[i].position.x();
        yLagrange[i] = localLagrangePoints[i].position.y();
        zLagrange[i] = localLagrangePoints[i].position.z();
        characteristicArea[i] = localLagrangePoints[i].characteristicArea;
        Area[i] = localLagrangePoints[i].weight;
        characteristicLength[i] = localLagrangePoints[i].characteristicLength;
        ElementNumber[i] = localLagrangePoints[i].elementNumber;

        normal_x[i] = localLagrangePoints[i].normal[0];
        normal_y[i] = localLagrangePoints[i].normal[1];
        normal_z[i] = localLagrangePoints[i].normal[2];
    }

    occa::memory o_xLagrange = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_yLagrange = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_zLagrange = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_characteristicArea = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_characteristicLength = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_ElementNumber = platform->device.malloc(numLagrangePoints * sizeof(int));
    occa::memory o_normal_x = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_normal_y = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_normal_z = platform->device.malloc(numLagrangePoints * sizeof(dfloat));

    // Copy Lagrange points from host to device
    o_xLagrange.copyFrom(xLagrange.data());
    o_yLagrange.copyFrom(yLagrange.data());
    o_zLagrange.copyFrom(zLagrange.data());
    o_characteristicArea.copyFrom(characteristicArea.data());
    o_characteristicLength.copyFrom(characteristicLength.data());
    o_ElementNumber.copyFrom(ElementNumber.data());
    o_normal_x.copyFrom(normal_x.data());
    o_normal_y.copyFrom(normal_y.data());
    o_normal_z.copyFrom(normal_z.data());

    // Passing the sdf values for the calculation of mu
    occa::memory o_sdfValues = platform->device.malloc(mesh->Np * mesh->Nelements * sizeof(dfloat), sdfValues.data());

    occa::memory o_SL = platform->device.malloc(numLagrangePoints * sizeof(dfloat));

    // Set up interpolator
    static pointInterpolation_t* interpolator = nullptr;

    // Set up the variables coming from findpts
    static std::vector<int> elemHost;
    static std::vector<dfloat> rxHost, ryHost, rzHost;

    if (!interpolator)
    {
        interpolator = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator->setPoints(xLagrange, yLagrange, zLagrange);
        interpolator->find();

        // Information about the elements containing the Lagrangian points and
        // their local coordinates
        auto &dat = interpolator->data();

        // Resize vectors
        elemHost.resize(numLagrangePoints);
        rxHost.resize(numLagrangePoints);
        ryHost.resize(numLagrangePoints);
        rzHost.resize(numLagrangePoints);

        // Fill host arrays from the findpts data
        for (int i = 0; i < numLagrangePoints; i++)
        {
          elemHost[i] = dat.el[i];

          // dat.r stores (xi, eta, zeta) contiguously for each Lagrange point
          rxHost[i] = dat.r[3*i + 0];
          ryHost[i] = dat.r[3*i + 1];
          rzHost[i] = dat.r[3*i + 2];
        }
    }

    // Transfer the mapping arrays to the device
    occa::memory o_elemList = platform->device.malloc(numLagrangePoints * sizeof(int), elemHost.data());
    occa::memory o_rx = platform->device.malloc(numLagrangePoints * sizeof(dfloat), rxHost.data());
    occa::memory o_ry = platform->device.malloc(numLagrangePoints * sizeof(dfloat), ryHost.data());
    occa::memory o_rz = platform->device.malloc(numLagrangePoints * sizeof(dfloat), rzHost.data());

    // temperature
    interpolator->eval(1, nrs->fieldOffset, o_S, numLagrangePoints, o_SL);

    double k;
    platform->options.getArgs("SCALAR00 DIFFUSIONCOEFF", k);
    CHTKernel(nrs->meshV->Nelements, k, time,
              nrs->meshV->o_x, nrs->meshV->o_y, nrs->meshV->o_z,
              platform->app->bc->o_usrwrk,
              nrs->fieldOffset,
              numLagrangePoints, o_xLagrange, o_yLagrange, o_zLagrange,  o_normal_x, o_normal_y, o_normal_z,
              o_characteristicArea, o_characteristicLength, o_ElementNumber,
              nrs->meshV->o_vgeo, nrs->meshV->o_D, o_S, o_FS, o_sdfValues);
}

// BC from the IBM
void PenaltyNoSlipBCCustomSource(double time)
{
    int rank;
    MPI_Comm_rank(platform->comm.mpiComm(), &rank);
    auto mesh = nrs->meshV;
    auto o_U = nrs->fluid->o_U;
    auto o_FU = nrs->fluid->o_explicitTerms();

    size_t numLagrangePoints = localLagrangePoints.size();

    std::vector<dfloat> xLagrange(numLagrangePoints), yLagrange(numLagrangePoints), zLagrange(numLagrangePoints);
    std::vector<dfloat> characteristicArea(numLagrangePoints), Area(numLagrangePoints), characteristicLength(numLagrangePoints);
    std::vector<int>   ElementNumber(numLagrangePoints);
    std::vector<dfloat> normal_x(numLagrangePoints), normal_y(numLagrangePoints), normal_z(numLagrangePoints);


    for (size_t i = 0; i < numLagrangePoints; ++i) {
        xLagrange[i] = localLagrangePoints[i].position.x();
        yLagrange[i] = localLagrangePoints[i].position.y();
        zLagrange[i] = localLagrangePoints[i].position.z();
        characteristicArea[i] = localLagrangePoints[i].characteristicArea;
        Area[i] = localLagrangePoints[i].weight;
        characteristicLength[i] = localLagrangePoints[i].characteristicLength;
        ElementNumber[i] = localLagrangePoints[i].elementNumber;

        // normal
        normal_x[i] = localLagrangePoints[i].normal[0];
        normal_y[i] = localLagrangePoints[i].normal[1];
        normal_z[i] = localLagrangePoints[i].normal[2];
    }

    occa::memory o_xLagrange = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_yLagrange = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_zLagrange = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_characteristicArea = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_characteristicLength = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_ElementNumber = platform->device.malloc(numLagrangePoints * sizeof(int));
    occa::memory o_normal_x = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_normal_y = platform->device.malloc(numLagrangePoints * sizeof(dfloat));
    occa::memory o_normal_z = platform->device.malloc(numLagrangePoints * sizeof(dfloat));

    // Copy Lagrange points from host to device
    o_xLagrange.copyFrom(xLagrange.data());
    o_yLagrange.copyFrom(yLagrange.data());
    o_zLagrange.copyFrom(zLagrange.data());
    o_characteristicArea.copyFrom(characteristicArea.data());
    o_characteristicLength.copyFrom(characteristicLength.data());
    o_ElementNumber.copyFrom(ElementNumber.data());
    o_normal_x.copyFrom(normal_x.data());
    o_normal_y.copyFrom(normal_y.data());
    o_normal_z.copyFrom(normal_z.data());


    // Allocate memory on the device for the velocity and pressure at the Lagrange points
    occa::memory o_uL = platform->device.malloc(nrs->meshV->dim * numLagrangePoints * sizeof(dfloat));
    occa::memory o_pL = platform->device.malloc(numLagrangePoints * sizeof(dfloat));

    // Set up interpolator for velocity and pressure
    static pointInterpolation_t* interpolator = nullptr;

    // Set up the variables coming from findpts
    static std::vector<int>    elemHost;
    static std::vector<dfloat> rxHost, ryHost, rzHost;

    if (!interpolator) {
        interpolator = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator->setPoints(xLagrange, yLagrange, zLagrange);
        interpolator->find();

        // Information about the elements containing the Lagrangian points and their local coordinates
        auto &dat = interpolator->data();

        // Resize vectors
        elemHost.resize(numLagrangePoints);
        rxHost.resize(numLagrangePoints);
        ryHost.resize(numLagrangePoints);
        rzHost.resize(numLagrangePoints);

        // Fill host arrays from the findpts data
        for (int i = 0; i < numLagrangePoints; i++) {
          elemHost[i] = dat.el[i];

          // dat.r stores (xi, eta, zeta) contiguously for each Lagrange point
          rxHost[i] = dat.r[3*i + 0];
          ryHost[i] = dat.r[3*i + 1];
          rzHost[i] = dat.r[3*i + 2];
        }
    }

    // Build mapping from element to its Lagrange points
    int nElements = nrs->meshV->Nelements;
    // Count number of Lagrange points per element
    std::vector<int> elementCounts(nElements, 0);
    for (size_t i = 0; i < numLagrangePoints; i++) {
        int e = elemHost[i];
        elementCounts[e]++;
    }

    // Build offsets array
    std::vector<int> elementOffsets(nElements+1, 0);
    for (int e = 0; e < nElements; e++)
        elementOffsets[e+1] = elementOffsets[e] + elementCounts[e];

    // Build a contiguous list of Lagrange point indices for each element
    std::vector<int> elementLagrangeIndices(numLagrangePoints, 0);
    std::vector<int> currentIndex = elementOffsets; // start positions for each element
    for (size_t i = 0; i < numLagrangePoints; i++) {
        int e = elemHost[i];
        elementLagrangeIndices[currentIndex[e]++] = i;
    }

    // Transfer the mapping arrays to the device
    occa::memory o_elemList = platform->device.malloc(numLagrangePoints * sizeof(int), elemHost.data());
    occa::memory o_rx       = platform->device.malloc(numLagrangePoints * sizeof(dfloat), rxHost.data());
    occa::memory o_ry       = platform->device.malloc(numLagrangePoints * sizeof(dfloat), ryHost.data());
    occa::memory o_rz       = platform->device.malloc(numLagrangePoints * sizeof(dfloat), rzHost.data());

    occa::memory o_elementOffsets = platform->device.malloc((nElements+1) * sizeof(int), elementOffsets.data());
    occa::memory o_elementLagrangeIndices = platform->device.malloc(numLagrangePoints * sizeof(int), elementLagrangeIndices.data());

    // Evaluate velocity and pressure at the Lagrange points
    interpolator->eval(nrs->meshV->dim, nrs->fluid->fieldOffset, o_U, numLagrangePoints, o_uL);
    interpolator->eval(1, nrs->fluid->fieldOffset, nrs->fluid->o_P, numLagrangePoints, o_pL);

    // Passing the sdf values for the calculation of mu
    occa::memory o_sdfValues = platform->device.malloc(nrs->meshV->Np * nrs->meshV->Nelements * sizeof(dfloat), sdfValues.data());

    // Call the kernel for each velocity component (loop from 1 to 3), now passing the element mapping arrays.
    for (unsigned int vid = 0; vid < 3; ++vid)
      PenaltyNoSlipBCKernel(nrs->meshV->Nelements,
                            nrs->meshV->o_x,
                            nrs->meshV->o_y,
                            nrs->meshV->o_z,
                            o_U,
                            vid * nrs->fluid->fieldOffset,
                            nrs->fluid->fieldOffset,
                            o_FU,
                            numLagrangePoints,
                            o_xLagrange,
                            o_yLagrange,
                            o_zLagrange,
                            o_normal_x,
                            o_normal_y,
                            o_normal_z,
                            nrs->dt[0],
                            o_characteristicArea,
                            o_characteristicLength,
                            o_ElementNumber,
                            vid,
                            o_uL,
                            nrs->meshV->o_gllw,
                            nrs->meshV->o_gllz,
                            o_elemList,
                            o_rx,
                            o_ry,
                            o_rz,
                            nrs->meshV->o_vgeo,
                            o_sdfValues,
                            o_pL,
                            o_elementOffsets,
                            o_elementLagrangeIndices,
                            nrs->fluid->o_P,
                            nrs->meshV->o_D);

    // Copy interpolated Lagrange-point velocities to host once.
    uL_host.resize(nrs->meshV->dim * numLagrangePoints);
    if (numLagrangePoints > 0)
        o_uL.copyTo(uL_host.data());
}

void material_props(double time)
{
  auto mesh = nrs->meshV;
  int n_gll_points = mesh->Np * mesh->Nelements;
  occa::memory o_sdfValues = platform->device.malloc(n_gll_points * sizeof(dfloat));

  // Copy sdfValues from host to device
  o_sdfValues.copyFrom(sdfValues.data());

  // modify viscosity inside the body to discourage flow penetration
  dfloat mu;
  platform->options.getArgs("FLUID VISCOSITY", mu);
  auto o_mue = nrs->fluid->o_diffusionCoeff();
  viscosityKernel(nrs->meshV->Nelements, mu, o_sdfValues , o_mue);
}

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
  PenaltyNoSlipBCKernel = oudfBuildKernel(kernelInfo , "PenaltyNoSlipBC");
  viscosityKernel = oudfBuildKernel(kernelInfo, "viscosity");
  CHTKernel = oudfBuildKernel(kernelInfo , "CHT");
}

// NekRS accepts one userSource callback. Apply both IBM source terms.
void CombinedIBMSource(double time)
{
  PenaltyNoSlipBCCustomSource(time);
  CHTKernelHeatSource(time);
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;

  // Register both IBM momentum and temperature source terms
  nrs->userSource = &CombinedIBMSource;

  // kernel for changing the visosity
  nrs->userProperties = &material_props;

  if (platform->options.getArgs("RESTART FILE NAME").empty())
  {
    // apply initial conditions for velocity, then copy into the velocity array
    std::vector<dfloat> U(mesh->dim * nrs->fluid->fieldOffset, 0.0);

    for (int n = 0; n < mesh->Nlocal; ++n)
      U[n + 2 * nrs->fluid->fieldOffset] = 1.0;  // z-velocity

    nrs->fluid->o_solution().copyFrom(U.data(), U.size());
  }

  read_stl_file();
}

void UDF_ExecuteStep(double time, int tstep)
{
}

