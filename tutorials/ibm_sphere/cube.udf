// Classify Points using VTK  (determines the signed distances magnitude & sign by reading the GLL points and the STL file)
// This is a different approach to what embree is doing

std::vector<double> classifyPointsWithVTK(const std::vector<Point>& testPoints, const std::string& stlFilename) {
    // Load the STL file
    vtkSmartPointer<vtkSTLReader> reader = vtkSmartPointer<vtkSTLReader>::New();
    reader->SetFileName(stlFilename.c_str());
    reader->Update();
    vtkSmartPointer<vtkPolyData> polyData = reader->GetOutput();

    // Create an implicit function based on the polydata
    vtkSmartPointer<vtkImplicitPolyDataDistance> implicitDistance =
    vtkSmartPointer<vtkImplicitPolyDataDistance>::New();
    implicitDistance->SetInput(polyData);

    // Compute signed distances for all test points
    std::vector<double> distances(testPoints.size());
    for (size_t i = 0; i < testPoints.size(); ++i) {
        const auto& point = testPoints[i];
        double queryPoint[3] = { point.px, point.py, point.pz };
        distances[i] = implicitDistance->EvaluateFunction(queryPoint);
    }
    return distances;
}

// Function to write surface mesh data to a VTK file (for visualizing the resulting triangulated surface)
void writeSurfaceMeshToVTK(
    const std::string& filename,
    const std::vector<Point_3>& points,
    const std::vector<std::array<std::size_t, 3>>& faces) {

    std::ofstream vtkFile(filename);

    // Write VTK header
    vtkFile << "# vtk DataFile Version 3.0\n";
    vtkFile << "Surface Mesh Data\n";
    vtkFile << "ASCII\n";
    vtkFile << "DATASET POLYDATA\n";

    // Write vertices
    vtkFile << "POINTS " << points.size() << " double\n";
    for (const auto& point : points) {
        vtkFile << point.x() << " " << point.y() << " " << point.z() << "\n";
    }

    // Write faces
    vtkFile << "POLYGONS " << faces.size() << " " << (4 * faces.size()) << "\n";
    for (const auto& face : faces) {
        vtkFile << "3 " << face[0] << " " << face[1] << " " << face[2] << "\n";
    }

    vtkFile.close();
}

// Function to compute 3-point Gauss integration points for a triangle and their weights
std::vector<IntegrationPoint> computeIntegrationPointsForTriangle(
    const Point_3& v1, const Point_3& v2, const Point_3& v3)
{
    // 3-point Gaussian integration rule (barycentric coordinates)
    std::array<std::array<dfloat, 3>, 3> barycentricPoints = {{
        {1.0 / 6, 1.0 / 6, 2.0 / 3},
        {2.0 / 3, 1.0 / 6, 1.0 / 6},
        {1.0 / 6, 2.0 / 3, 1.0 / 6}
    }};

    // Compute area of triangle
    dfloat area = computeTriangleArea(v1, v2, v3);

    // Equal weights for the 3-point Gaussian rule
    dfloat weight = area / 3.0;

    std::vector<IntegrationPoint> integrationPoints;
    integrationPoints.reserve(3);

    // Initialize STL implicit surface for normal computation
    static vtkSmartPointer<vtkPolyData> s_stlPoly = nullptr;
    static vtkSmartPointer<vtkImplicitPolyDataDistance> s_sdf = nullptr;
    static bool s_initTried = false;

    if (!s_initTried) {
        s_initTried = true;
        vtkNew<vtkSTLReader> reader;
        reader->SetFileName(kSTLFile.c_str());
        reader->Update();
        vtkPolyData* poly = reader->GetOutput();
        if (poly && poly->GetNumberOfCells() > 0) {
            s_stlPoly = poly;
            vtkNew<vtkImplicitPolyDataDistance> ipd;
            ipd->SetInput(s_stlPoly);
            s_sdf = ipd;
        } else {
            std::cerr << "[computeIntegrationPointsForTriangle] ERROR: Failed to load STL or STL has no cells.\n";
        }
    }

    // Loop over integration points
    for (const auto& bary : barycentricPoints) {
        Point_3 position(
            bary[0] * v1.x() + bary[1] * v2.x() + bary[2] * v3.x(),
            bary[0] * v1.y() + bary[1] * v2.y() + bary[2] * v3.y(),
            bary[0] * v1.z() + bary[1] * v2.z() + bary[2] * v3.z()
        );

        std::array<dfloat, 3> normal = {0.0, 0.0, 0.0};

        if (s_sdf) {
            double q[3] = { position.x(), position.y(), position.z() };
            double cp[3] = {0, 0, 0};
            (void)s_sdf->EvaluateFunctionAndGetClosestPoint(q, cp);
            double g[3] = {0.0, 0.0, 0.0};
            s_sdf->EvaluateGradient(cp, g);

            const double len = std::sqrt(g[0]*g[0] + g[1]*g[1] + g[2]*g[2]);
            if (len > 0.0) {
                normal = { static_cast<dfloat>(g[0]/len),
                           static_cast<dfloat>(g[1]/len),
                           static_cast<dfloat>(g[2]/len) };
            } else {
                std::cerr << "[computeIntegrationPointsForTriangle] WARNING: Zero-length SDF gradient at integration point.\n";
            }
        } else {
            std::cerr << "[computeIntegrationPointsForTriangle] ERROR: STL SDF not initialized; cannot compute normal.\n";
        }

        // Store the integration point
        integrationPoints.push_back({ position, weight, normal });
    }

    return integrationPoints;
}

// Function to compute 1-point Lagrange point for a triangle and its weight
std::vector<LagrangePoint> computeLagrangePointsForTriangle(
    const Point_3& v1, const Point_3& v2, const Point_3& v3, int elementNumber)
{
    std::array<dfloat, 3> barycentricPoint = {1.0 / 3, 1.0 / 3, 1.0 / 3};
    dfloat area = computeTriangleArea(v1, v2, v3);

    const auto edgeLength = [](const Point_3& a, const Point_3& b) {
        const dfloat dx = b.x() - a.x();
        const dfloat dy = b.y() - a.y();
        const dfloat dz = b.z() - a.z();
        return std::sqrt(dx * dx + dy * dy + dz * dz);
    };

    const dfloat L1 = edgeLength(v1, v2);
    const dfloat L2 = edgeLength(v2, v3);
    const dfloat L3 = edgeLength(v3, v1);
    dfloat characteristicLength = (L1 + L2 + L3) / 3.0;
    dfloat P = (L1 + L2 + L3) / 2.0;
    dfloat characteristicArea = sqrt(P * (P - L1) * (P - L2) * (P - L3));
    dfloat weight = area;

    Point_3 position(
        barycentricPoint[0] * v1.x() + barycentricPoint[1] * v2.x() + barycentricPoint[2] * v3.x(),
        barycentricPoint[0] * v1.y() + barycentricPoint[1] * v2.y() + barycentricPoint[2] * v3.y(),
        barycentricPoint[0] * v1.z() + barycentricPoint[1] * v2.z() + barycentricPoint[2] * v3.z()
    );

    // Normal from gradient of STL signed distance (VTK)
    static vtkSmartPointer<vtkPolyData> s_stlPoly = nullptr;
    static vtkSmartPointer<vtkImplicitPolyDataDistance> s_sdf = nullptr;
    static bool s_initTried = false;

    if (!s_initTried) {
        s_initTried = true;
        vtkNew<vtkSTLReader> reader;
        reader->SetFileName(kSTLFile.c_str());
        reader->Update();
        vtkPolyData* poly = reader->GetOutput();
        if (poly && poly->GetNumberOfCells() > 0) {
            s_stlPoly = poly;
            vtkNew<vtkImplicitPolyDataDistance> ipd;
            ipd->SetInput(s_stlPoly);
            s_sdf = ipd;
        } else {
            std::cerr << "[computeLagrangePointsForTriangle] ERROR: Failed to load STL or STL has no cells.\n";
        }
    }

    std::array<dfloat, 3> normal = {0.0, 0.0, 0.0};
    if (s_sdf) {
        double q[3] = { position.x(), position.y(), position.z() };
        double cp[3] = {0,0,0};
        (void)s_sdf->EvaluateFunctionAndGetClosestPoint(q, cp);
        double g[3] = { 0.0, 0.0, 0.0 };
        s_sdf->EvaluateGradient(cp, g);

        const double len = std::sqrt(g[0]*g[0] + g[1]*g[1] + g[2]*g[2]);
        if (len > 0.0) {
            normal = { static_cast<dfloat>(g[0]/len),
                       static_cast<dfloat>(g[1]/len),
                       static_cast<dfloat>(g[2]/len) };
        } else {
            std::cerr << "[computeLagrangePointsForTriangle] ERROR: Zero-length SDF gradient at Lagrange point.\n";
        }
    } else {
        std::cerr << "[computeLagrangePointsForTriangle] ERROR: STL SDF not initialized; cannot compute normal.\n";
    }
    return { {position, weight, characteristicArea, characteristicLength, elementNumber, normal} };
}

// Function to convert points to array
std::vector<std::array<dfloat, 3>> convertPointsToArrays(const std::vector<Point>& points) {
    std::vector<std::array<dfloat, 3>> arrays;
    for (const auto& point : points) {
        arrays.push_back({point.px, point.py, point.pz});
    }
    return arrays;
}

// Extract an iso-surface mesh (points and faces) from the given structured grid data.
IsoSurfaceMesh extractIsoSurfaceMesh(const std::vector<std::array<dfloat, 3>> &myPoints,
                                      const std::vector<dfloat> &mySDFValues,
                                      const int numX)
{
  IsoSurfaceMesh meshData;

  if (myPoints.empty() || mySDFValues.empty()) {
    // Return empty mesh if no input.
    return meshData;
  }

  // Create VTK points and scalar array.
  vtkSmartPointer<vtkPoints> vtkPts = vtkSmartPointer<vtkPoints>::New();
  vtkSmartPointer<vtkFloatArray> sdfArray = vtkSmartPointer<vtkFloatArray>::New();
  for (size_t i = 0; i < myPoints.size(); ++i) {
    double p[3] = { myPoints[i][0], myPoints[i][1], myPoints[i][2] };
    vtkPts->InsertNextPoint(p);
    sdfArray->InsertNextValue(static_cast<dfloat>(mySDFValues[i]));
  }

  // Create a VTK structured grid.
  vtkSmartPointer<vtkStructuredGrid> structuredGrid = vtkSmartPointer<vtkStructuredGrid>::New();
  int dims[3] = { numX, numX, numX };
  structuredGrid->SetDimensions(dims);
  structuredGrid->SetPoints(vtkPts);
  structuredGrid->GetPointData()->SetScalars(sdfArray);

  // Extract the iso-surface using vtkContourFilter.
  vtkSmartPointer<vtkContourFilter> contourFilter = vtkSmartPointer<vtkContourFilter>::New();
  contourFilter->SetInputData(structuredGrid);
  contourFilter->SetValue(0, 0.0); // Extract the 0 level-set.
  contourFilter->Update();

  vtkPolyData *isoPolyData = contourFilter->GetOutput();
  if (!isoPolyData || !isoPolyData->GetPoints()) {
    std::cerr << "No iso-surface extracted." << std::endl;
    return meshData;
  }

  // Extract iso-surface points.
  vtkPoints *isoPoints = isoPolyData->GetPoints();
  vtkIdType numIsoPoints = isoPoints->GetNumberOfPoints();
  for (vtkIdType i = 0; i < numIsoPoints; ++i) {
    double p[3];
    isoPoints->GetPoint(i, p);
    meshData.points.push_back({ static_cast<dfloat>(p[0]),
                                 static_cast<dfloat>(p[1]),
                                 static_cast<dfloat>(p[2]) });
  }

  // Extract the connectivity (faces) from the iso-surface.
  vtkCellArray *polys = isoPolyData->GetPolys();
  if (polys) {
    polys->InitTraversal();
    vtkIdType npts;
    vtkIdType const* pts = nullptr;
    while (polys->GetNextCell(npts, pts)) {
      if (npts == 3) {  // we are interested in triangles
        meshData.faces.push_back({ static_cast<std::size_t>(pts[0]),
                                    static_cast<std::size_t>(pts[1]),
                                    static_cast<std::size_t>(pts[2]) });
      }
    }
  }

  return meshData;
}

// Reconstruct the interface per element, build forcing/quadrature points,
// then gather the visualization mesh and compare reconstructed area with STL area.
void identifyCuttingTrianglesWithIntersections(
    const std::vector<Point>& quadPoints,
    int pointsPerElement,
    const std::vector<dfloat>& sdfValues)
{

    int p = std::cbrt(pointsPerElement) - 1; // Compute polynomial order

    globalIntegrationPoints.clear();
    globalLagrangePoints.clear();

    std::vector<Point_3> localPoints;
    std::vector<std::array<std::size_t, 3>> localFaces;

    // Loop over all elements
    for (size_t elementIdx = 0; elementIdx < quadPoints.size(); elementIdx += pointsPerElement) {
        std::vector<Point> elementQuadPoints(pointsPerElement);
        std::vector<dfloat> elementSdfValues(pointsPerElement);

        for (int i = 0; i < pointsPerElement; ++i) {
            int idx = elementIdx + i;
            elementQuadPoints[i] = quadPoints[idx];
            elementSdfValues[i] = sdfValues[idx];
        }

        std::vector<std::array<dfloat, 3>> convertedElementQuadPoints = convertPointsToArrays(elementQuadPoints);
        int numX = p + 1;

        // VTK interpolates the sampled SDF within the element and triangulates
        // its zero contour. Original STL vertices are not added to this mesh.
        IsoSurfaceMesh isoMesh = extractIsoSurfaceMesh(convertedElementQuadPoints, elementSdfValues, numX);

        for (const auto &face : isoMesh.faces) {

            Point_3 v1(isoMesh.points[face[0]][0], isoMesh.points[face[0]][1], isoMesh.points[face[0]][2]);
            Point_3 v2(isoMesh.points[face[1]][0], isoMesh.points[face[1]][1], isoMesh.points[face[1]][2]);
            Point_3 v3(isoMesh.points[face[2]][0], isoMesh.points[face[2]][1], isoMesh.points[face[2]][2]);

            auto integrationPoints = computeIntegrationPointsForTriangle(v1, v2, v3);
            auto LagrangePoints    = computeLagrangePointsForTriangle(v1, v2, v3, elementIdx / pointsPerElement);

            globalIntegrationPoints.insert(globalIntegrationPoints.end(), integrationPoints.begin(), integrationPoints.end());
            globalLagrangePoints.insert(globalLagrangePoints.end(), LagrangePoints.begin(), LagrangePoints.end());
        }

        // Adjust face indices
        // Compute offset for the current element.
        size_t offset = localPoints.size();
        // Append the points from this element.
        for (const auto& pt : isoMesh.points) {
            localPoints.push_back(Point_3(pt[0], pt[1], pt[2]));
        }

        // Adjust each face index and then append the faces.
        for (auto& face : isoMesh.faces) {
            face[0] += offset;
            face[1] += offset;
            face[2] += offset;
            localFaces.push_back(face);
        }
    }

    int rank, size;
    MPI_Comm_rank(platform->comm.mpiComm(), &rank);
    MPI_Comm_size(platform->comm.mpiComm(), &size);

    //Adjust Face Indices
    // The face indices in localFaces are relative to localPoints.
    // To create a consistent global mesh, each rank's face indices must be offset
    // by the total number of points from all lower-ranked processes.

    // Get the number of local points
    int localNumPoints = localPoints.size();

    // Gather the number of points from all processes
    std::vector<int> allLocalNumPoints(size);
    MPI_Allgather(&localNumPoints, 1, MPI_INT, allLocalNumPoints.data(), 1, MPI_INT, platform->comm.mpiComm());

    // Compute the offset for the current rank
    int pointOffset = 0;
    for (int i = 0; i < rank; ++i) {
        pointOffset += allLocalNumPoints[i];
    }

    // Adjust each local face by adding the point offset
    for (auto &face : localFaces) {
        face[0] += pointOffset;
        face[1] += pointOffset;
        face[2] += pointOffset;
    }

    // === Step 1: Gather All Points and Faces ===
    std::vector<Point_3> globalPoints;
    std::vector<std::array<std::size_t, 3>> globalFaces;

    int localNumFaces = localFaces.size();

    // Gather the number of points and faces from all ranks (as element counts)
    std::vector<int> allNumPoints(size), allNumFaces(size);
    MPI_Gather(&localNumPoints, 1, MPI_INT, allNumPoints.data(), 1, MPI_INT, 0, platform->comm.mpiComm());
    MPI_Gather(&localNumFaces,   1, MPI_INT, allNumFaces.data(),   1, MPI_INT, 0, platform->comm.mpiComm());

    // Prepare arrays for MPI_Gatherv counts and displacements (on rank 0)
    std::vector<int> recvCountsPoints;
    std::vector<int> recvCountsFaces;
    std::vector<int> pointDisplacements(size, 0), faceDisplacements(size, 0);

    if (rank == 0) { // rank 0 does the conversion
        recvCountsPoints.resize(size);
        recvCountsFaces.resize(size);
        int totalBytesPoints = 0;
        int totalBytesFaces = 0;
        for (int i = 0; i < size; ++i) {
            // Convert element counts to byte counts
            recvCountsPoints[i] = allNumPoints[i] * sizeof(Point_3);
            recvCountsFaces[i]  = allNumFaces[i]  * sizeof(std::array<std::size_t, 3>);
            if (i > 0) {
                pointDisplacements[i] = pointDisplacements[i-1] + recvCountsPoints[i-1];
                faceDisplacements[i]  = faceDisplacements[i-1]  + recvCountsFaces[i-1];
            }
            totalBytesPoints += recvCountsPoints[i];
            totalBytesFaces  += recvCountsFaces[i];
        }
        // Resize global vectors to hold all the data
        globalPoints.resize(totalBytesPoints / sizeof(Point_3));
        globalFaces.resize(totalBytesFaces / sizeof(std::array<std::size_t, 3>));
    }

    //  Gather Data Using MPI_Gatherv with MPI_BYTE
    MPI_Gatherv(localPoints.data(),
                localNumPoints * sizeof(Point_3), MPI_BYTE,
                globalPoints.data(),
                (rank == 0 ? recvCountsPoints.data() : nullptr),
                (rank == 0 ? pointDisplacements.data() : nullptr),
                MPI_BYTE, 0, platform->comm.mpiComm());

    MPI_Gatherv(localFaces.data(),
                localNumFaces * sizeof(std::array<std::size_t, 3>), MPI_BYTE,
                globalFaces.data(),
                (rank == 0 ? recvCountsFaces.data() : nullptr),
                (rank == 0 ? faceDisplacements.data() : nullptr),
                MPI_BYTE, 0, platform->comm.mpiComm());

    //  Write to VTK on Rank 0
    if (rank == 0) {
        // Write the VTK file for the reconstructed mesh
        writeSurfaceMeshToVTK("surface_mesh.vtk", globalPoints, globalFaces);

    }

    // Check conservation of surface quadrature weights: each centroid carries
    // its triangle area. Reduce the scalar sum rather than gather all points.
    dfloat localArea = 0.0;
    for (const auto& point : globalLagrangePoints) {
        localArea += point.weight;
    }
    dfloat triangulatedArea = 0.0;
    static_assert(sizeof(dfloat) == sizeof(double),
                  "This tutorial's MPI area reduction assumes double precision");
    MPI_Reduce(&localArea, &triangulatedArea, 1, MPI_DOUBLE, MPI_SUM,
               0, platform->comm.mpiComm());

    if (rank == 0) {
        // Compute the area of the STL surface
        dfloat stlSurfaceArea = computeSTLSurfaceArea(STLvertices);

        // Compute the absolute and relative differences
        dfloat absoluteDifference = std::fabs(triangulatedArea - stlSurfaceArea);
        dfloat relativeDifference = absoluteDifference / stlSurfaceArea;

        // Output the results
        std::cout << "STL Surface Area: " << stlSurfaceArea << std::endl;
        std::cout << "Triangulated Surface Area: " << triangulatedArea << std::endl;
        std::cout << "Absolute Difference: " << absoluteDifference << std::endl;
        std::cout << "Relative Difference: " << relativeDifference * 100.0 << " %" << std::endl;
    }
}


// Main Function
int main2() {
    // Parse the STL file
    if (parse_stl(kSTLFile, STLvertices, STLnormals)) {
        const std::vector<Point>& testPoints = quad_points;

        // Classify points using VTK
        std::vector<double> distances = classifyPointsWithVTK(quad_points, kSTLFile);

        //uncomment to use EMBREE
        // std::vector<double> distances = classifyPointsWithEMBREE(quad_points, kSTLFile);

        sdfValues.resize(quad_points.size());
        for (size_t i = 0; i < quad_points.size(); ++i) {
            sdfValues[i] = static_cast<dfloat>(distances[i]);
        }

        // Call the function to identify cutting triangles with intersections
        identifyCuttingTrianglesWithIntersections(quad_points, QuadPointsPerElement, sdfValues);


        return 0; // Indicate successful execution
    } else {
        std::cerr << "Parsing failed." << std::endl;
        return 1; // Indicate failure
    }
}

