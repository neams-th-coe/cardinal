      yL[i]  = globalIntegrationPoints[i].position.y();
      zL[i]  = globalIntegrationPoints[i].position.z();
      nLx[i] = globalIntegrationPoints[i].normal[0];
      nLy[i] = globalIntegrationPoints[i].normal[1];
      nLz[i] = globalIntegrationPoints[i].normal[2];
      wL[i]  = globalIntegrationPoints[i].weight; // surface area weight per point
    }

    // set up the interpolator
    static pointInterpolation_t* interpolator = nullptr;   // for Sij
    static pointInterpolation_t* interpolator2 = nullptr;    // for pressure
    static pointInterpolation_t* interpolator3 = nullptr;    // for viscosity
    static pointInterpolation_t* interpolator4 = nullptr;    // for divergence of velocity
    static pointInterpolation_t* interpolator5 = nullptr;    // for force

    // interpolate Sij from Eulerian to Lagrangian points
    if (!interpolator) {
        interpolator = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator->setPoints(xL, yL, zL);
        interpolator->find();
    }
    interpolator->eval(6, nrs->fluid->fieldOffset, o_Sij , numIntegrationPoints, o_SijL);

    // interpolate pressure from Eulerian to Lagrangian points
    if (!interpolator2) {
        interpolator2 = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator2->setPoints(xL, yL, zL);
        interpolator2->find();
    }
    interpolator2->eval(1, nrs->fluid->fieldOffset, nrs->fluid->o_P, numIntegrationPoints, o_pL);

     // interpolate viscosity from Eulerian to Lagrangian points
    if (!interpolator3) {
        interpolator3 = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator3->setPoints(xL, yL, zL);
        interpolator3->find();
    }
    interpolator3->eval(1, nrs->fluid->fieldOffset, nrs->fluid->o_diffusionCoeff(), numIntegrationPoints, o_muL);

    // // interpolate divergence of velocity from Eulerian to Lagrangian points
    if (!interpolator4) {
        interpolator4 = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator4->setPoints(xL, yL, zL);
        interpolator4->find();
    }
    interpolator4->eval(1, nrs->fluid->fieldOffset, o_divU, numIntegrationPoints, o_divUL);

   // interpolate force  from Eulerian to Lagrangian points
    if (!interpolator5) {
        interpolator5 = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
        interpolator5->setPoints(xL, yL, zL);
        interpolator5->find();
    }
    interpolator5->eval(3, nrs->fluid->fieldOffset, nrs->fluid->o_explicitTerms(), numIntegrationPoints, o_FL);

    // copy from GPU to CPU
    std::vector<dfloat> pL(numIntegrationPoints), SijL(6 * numIntegrationPoints), muL(numIntegrationPoints), divUL(numIntegrationPoints), FL(3 * numIntegrationPoints);

    o_pL.copyTo(pL.data());
    o_SijL.copyTo(SijL.data());
    o_muL.copyTo(muL.data());
    o_divUL.copyTo(divUL.data());
    o_FL.copyTo(FL.data());

    // Local force components
    dfloat F_local  = 0.0, pressure_x = 0.0, pressure_y = 0.0, pressure_z = 0.0;


    for (size_t i = 0; i < numIntegrationPoints ; ++i) {
        const dfloat nx = nLx[i], ny = nLy[i], nz = nLz[i];
        const dfloat wi = wL[i];
        const dfloat p  = pL[i];
        // pull Sij at i
        const dfloat S11 = SijL[i + 0*numIntegrationPoints];
        const dfloat S21 = SijL[i + 3*numIntegrationPoints];
        const dfloat S31 = SijL[i + 5*numIntegrationPoints];

        const dfloat S12 = S21;
        const dfloat S22 = SijL[i + 1*numIntegrationPoints];
        const dfloat S32 = SijL[i + 4*numIntegrationPoints];

        const dfloat S13 = S31;
        const dfloat S23 = S32;
        const dfloat S33 = SijL[i + 2*numIntegrationPoints];

        const dfloat scale = -2 * muL[i] * wi;

        pressure_x += -p * nx * wi;
        pressure_y += -p * ny * wi;
        pressure_z += -p * nz * wi;


        const dfloat dragx = scale*(S11 * nx + S12 * ny + S13 * nz);
        const dfloat dragy = scale*(S21 * nx + S22 * ny + S23 * nz);
        const dfloat dragz = scale*(S31 * nx + S32 * ny + S33 * nz);

        // F total
        F_local += sqrt(dragx * dragx + dragy * dragy + dragz * dragz);
    }

    dfloat ViscousForce = 0.0, XPressureForce = 0.0, YPressureForce = 0.0, ZPressureForce = 0.0;
    MPI_Allreduce(&F_local, &ViscousForce, 1, MPI_DOUBLE, MPI_SUM, platform->comm.mpiComm());
    MPI_Allreduce(&pressure_x, &XPressureForce, 1, MPI_DOUBLE, MPI_SUM, platform->comm.mpiComm());
    MPI_Allreduce(&pressure_y, &YPressureForce, 1, MPI_DOUBLE, MPI_SUM, platform->comm.mpiComm());
    MPI_Allreduce(&pressure_z, &ZPressureForce, 1, MPI_DOUBLE, MPI_SUM, platform->comm.mpiComm());

  if (platform->comm.mpiRank() == 0) {
    std::cout << std::scientific
              << "[IBM] Viscous Drag Force = (" << ViscousForce << ")" << std::endl;
    std::cout << std::scientific
              << "[IBM] X Pressure Force = (" << XPressureForce << ")" << std::endl;
    std::cout << std::scientific
              << "[IBM] Y Pressure Force = (" << YPressureForce << ")" << std::endl;
    std::cout << std::scientific
              << "[IBM] Z Pressure Force  = (" << ZPressureForce << ")" << std::endl;

  }
}
