// Classify Points using VTK  (determines the signed distances magnitude & sign by reading the GLL points and the STL file)
// This is a different approach to what embree is doing

std::vector<double> classifyPointsWithVTK(const std::vector<Point>& testPoints, const std::string& stlFilename) {
    // Load the STL file
    vtkSmartPointer<vtkSTLReader> reader = vtkSmartPointer<vtkSTLReader>::New();
    reader->SetFileName(stlFilename.c_str());
    reader->Update();
    vtkSmartPointer<vtkPolyData> polyData = reader->GetOutput();

    // Create an implicit function based on the polydata
    vtkSmartPointer<vtkImplicitPolyDataDistance> implicitDistance =
    vtkSmartPointer<vtkImplicitPolyDataDistance>::New();
    implicitDistance->SetInput(polyData);

    // Compute signed distances for all test points
    std::vector<double> distances(testPoints.size());
    for (size_t i = 0; i < testPoints.size(); ++i) {
        const auto& point = testPoints[i];
        double queryPoint[3] = { point.px, point.py, point.pz };
        distances[i] = implicitDistance->EvaluateFunction(queryPoint);
    }
    return distances;
}

// convert from vertex to point
Point convertVertexToPoint(const Vertex& vertex) {
    Point point;
    point.px = vertex.x;
    point.py = vertex.y;
    point.pz = vertex.z;
    return point;
}


// Line segmenets of the mesh element (Specific to NekRS mesh pairs)
std::vector<std::pair<Point, Point>> getElementSegments(const std::vector<Point>& quadPoints, size_t elementIdx, int p) {
    std::vector<std::pair<int, int>> edgePairs;

    if (p == 1) {
        edgePairs = {
            {0, 1}, {0, 2}, {1, 3}, {2, 3},
            {4, 5}, {4, 6}, {5, 7}, {6, 7},
            {0, 4}, {1, 5}, {2, 6}, {3, 7}
        };
    } else {
        edgePairs = {

           {0, p}, // 0 - 2
           {0, p*p+p}, // 0 - 6
           {p, p*p+2*p}, // 2 - 8
           {p*p+p, p*p+2*p}, // 6 - 8
           {p*(p+1)*(p+1), p+p*(p+1)*(p+1)}, // 18 - 20
           {p*(p+1)*(p+1), p+p*p+p*(p+1)*(p+1)}, // 18 - 24
           {p+p*(p+1)*(p+1), p*p+2*p+p*(p+1)*(p+1)}, // 20 - 26
           {p*p+p+p*(p+1)*(p+1), p*p+2*p+p*(p+1)*(p+1)}, // 24 - 26
           {0, p*(p+1)*(p+1)}, // 0 - 18
           {p, p+p*(p+1)*(p+1)}, // 2 - 20
           {p*(p+1), p*p+p+p*(p+1)*(p+1)}, // 6- 24
           {p*p+2*p, p*p+2*p+p*(p+1)*(p+1)} // 8 - 26

        };
    }

    std::vector<std::pair<Point, Point>> elementSegments;
    for (const auto& edge : edgePairs) {
        Point p1 = quadPoints[elementIdx + edge.first];
        Point p2 = quadPoints[elementIdx + edge.second];
        elementSegments.push_back(std::make_pair(p1, p2));
    }

    return elementSegments;
}


// compare two points for equality within a threshold (to remove repeated points)
bool arePointsSimilar(const Point& a, const Point& b, dfloat threshold = 1e-6) {
    return std::sqrt((a.px - b.px) * (a.px - b.px) +
                     (a.py - b.py) * (a.py - b.py) +
                     (a.pz - b.pz) * (a.pz - b.pz)) < threshold;
}


// Function to write surface mesh data to a VTK file (for visualizing the resulting triangulated surface)
void writeSurfaceMeshToVTK(
    const std::string& filename,
    const std::vector<Point_3>& points,
    const std::vector<std::array<std::size_t, 3>>& faces) {

    std::ofstream vtkFile(filename);

    // Write VTK header
    vtkFile << "# vtk DataFile Version 3.0\n";
    vtkFile << "Surface Mesh Data\n";
    vtkFile << "ASCII\n";
    vtkFile << "DATASET POLYDATA\n";

    // Write vertices
    vtkFile << "POINTS " << points.size() << " double\n";
    for (const auto& point : points) {
        vtkFile << point.x() << " " << point.y() << " " << point.z() << "\n";
    }

    // Write faces
    vtkFile << "POLYGONS " << faces.size() << " " << (4 * faces.size()) << "\n";
    for (const auto& face : faces) {
        vtkFile << "3 " << face[0] << " " << face[1] << " " << face[2] << "\n";
    }

    vtkFile.close();
}


// Function to compute 3-point Gauss integration points for a triangle and their weights
std::vector<IntegrationPoint> computeIntegrationPointsForTriangle(
    const Point_3& v1, const Point_3& v2, const Point_3& v3)
{
    // 3-point Gaussian integration rule (barycentric coordinates)
    std::array<std::array<dfloat, 3>, 3> barycentricPoints = {{
        {1.0 / 6, 1.0 / 6, 2.0 / 3},
        {2.0 / 3, 1.0 / 6, 1.0 / 6},
        {1.0 / 6, 2.0 / 3, 1.0 / 6}
    }};

    // Compute area of triangle
    dfloat area = computeTriangleArea(v1, v2, v3);

    // Equal weights for the 3-point Gaussian rule
    dfloat weight = area / 3.0;

    std::vector<IntegrationPoint> integrationPoints;
    integrationPoints.reserve(3);

    // Initialize STL implicit surface for normal computation
    static vtkSmartPointer<vtkPolyData> s_stlPoly = nullptr;
    static vtkSmartPointer<vtkImplicitPolyDataDistance> s_sdf = nullptr;
    static bool s_initTried = false;

    if (!s_initTried) {
        s_initTried = true;
        vtkNew<vtkSTLReader> reader;
        reader->SetFileName(kSTLFile.c_str());
        reader->Update();
        vtkPolyData* poly = reader->GetOutput();
        if (poly && poly->GetNumberOfCells() > 0) {
            s_stlPoly = poly;
            vtkNew<vtkImplicitPolyDataDistance> ipd;
            ipd->SetInput(s_stlPoly);
            s_sdf = ipd;
        } else {
            std::cerr << "[computeIntegrationPointsForTriangle] ERROR: Failed to load STL or STL has no cells.\n";
        }
    }

    // Loop over integration points
    for (const auto& bary : barycentricPoints) {
        Point_3 position(
            bary[0] * v1.x() + bary[1] * v2.x() + bary[2] * v3.x(),
            bary[0] * v1.y() + bary[1] * v2.y() + bary[2] * v3.y(),
            bary[0] * v1.z() + bary[1] * v2.z() + bary[2] * v3.z()
        );

        std::array<dfloat, 3> normal = {0.0, 0.0, 0.0};

        if (s_sdf) {
            double q[3] = { position.x(), position.y(), position.z() };
            double cp[3] = {0, 0, 0};
            (void)s_sdf->EvaluateFunctionAndGetClosestPoint(q, cp);
            double g[3] = {0.0, 0.0, 0.0};
            s_sdf->EvaluateGradient(cp, g);

            const double len = std::sqrt(g[0]*g[0] + g[1]*g[1] + g[2]*g[2]);
            if (len > 0.0) {
                normal = { static_cast<dfloat>(g[0]/len),
                           static_cast<dfloat>(g[1]/len),
                           static_cast<dfloat>(g[2]/len) };
            } else {
                std::cerr << "[computeIntegrationPointsForTriangle] WARNING: Zero-length SDF gradient at integration point.\n";
            }
        } else {
            std::cerr << "[computeIntegrationPointsForTriangle] ERROR: STL SDF not initialized; cannot compute normal.\n";
        }

        // Store the integration point
        integrationPoints.push_back({ position, weight, normal });
    }

    return integrationPoints;
}

// Lagrange points
// Function to compute 1-point Lagrange point for a triangle and its weight
std::vector<LagrangePoint> computeLagrangePointsForTriangle(
    const Point_3& v1, const Point_3& v2, const Point_3& v3, int elementNumber)
{
    std::array<dfloat, 3> barycentricPoint = {1.0 / 3, 1.0 / 3, 1.0 / 3};
    dfloat area = computeTriangleArea(v1, v2, v3);

    const auto edgeLength = [](const Point_3& a, const Point_3& b) {
        const dfloat dx = b.x() - a.x();
        const dfloat dy = b.y() - a.y();
        const dfloat dz = b.z() - a.z();
        return std::sqrt(dx * dx + dy * dy + dz * dz);
    };

    const dfloat L1 = edgeLength(v1, v2);
    const dfloat L2 = edgeLength(v2, v3);
    const dfloat L3 = edgeLength(v3, v1);
    dfloat characteristicLength = (L1 + L2 + L3) / 3.0;
    dfloat P = (L1 + L2 + L3) / 2.0;
    dfloat characteristicArea = sqrt(P * (P - L1) * (P - L2) * (P - L3));
    dfloat weight = area;

    Point_3 position(
        barycentricPoint[0] * v1.x() + barycentricPoint[1] * v2.x() + barycentricPoint[2] * v3.x(),
        barycentricPoint[0] * v1.y() + barycentricPoint[1] * v2.y() + barycentricPoint[2] * v3.y(),
        barycentricPoint[0] * v1.z() + barycentricPoint[1] * v2.z() + barycentricPoint[2] * v3.z()
    );

    // Normal from gradient of STL signed distance (VTK)
    static vtkSmartPointer<vtkPolyData> s_stlPoly = nullptr;
    static vtkSmartPointer<vtkImplicitPolyDataDistance> s_sdf = nullptr;
    static bool s_initTried = false;

    if (!s_initTried) {
        s_initTried = true;
        vtkNew<vtkSTLReader> reader;
        reader->SetFileName(kSTLFile.c_str());
        reader->Update();
        vtkPolyData* poly = reader->GetOutput();
        if (poly && poly->GetNumberOfCells() > 0) {
            s_stlPoly = poly;
            vtkNew<vtkImplicitPolyDataDistance> ipd;
            ipd->SetInput(s_stlPoly);
            s_sdf = ipd;
        } else {
            std::cerr << "[computeLagrangePointsForTriangle] ERROR: Failed to load STL or STL has no cells.\n";
        }
    }

    std::array<dfloat, 3> normal = {0.0, 0.0, 0.0};
    if (s_sdf) {
        double q[3] = { position.x(), position.y(), position.z() };
        double cp[3] = {0,0,0};
        (void)s_sdf->EvaluateFunctionAndGetClosestPoint(q, cp);
        double g[3] = { 0.0, 0.0, 0.0 };
        s_sdf->EvaluateGradient(cp, g);

        const double len = std::sqrt(g[0]*g[0] + g[1]*g[1] + g[2]*g[2]);
        if (len > 0.0) {
            normal = { static_cast<dfloat>(g[0]/len),
                       static_cast<dfloat>(g[1]/len),
                       static_cast<dfloat>(g[2]/len) };
        } else {
            std::cerr << "[computeLagrangePointsForTriangle] ERROR: Zero-length SDF gradient at Lagrange point.\n";
        }
    } else {
        std::cerr << "[computeLagrangePointsForTriangle] ERROR: STL SDF not initialized; cannot compute normal.\n";
    }
    return { {position, weight, characteristicArea, characteristicLength, elementNumber, normal} };
}

// Function to compute the Euclidean distance between two points
dfloat distance(const Point& p1, const Point& p2) {
    dfloat dx = p2.px - p1.px;
    dfloat dy = p2.py - p1.py;
    dfloat dz = p2.pz - p1.pz;
    return std::sqrt(dx * dx + dy * dy + dz * dz);
}

