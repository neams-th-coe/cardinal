[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 3
  numSteps = 10000
  dt = 1e-2
  writeInterval = 1000
  scalars = temperature

[MESH]
  file = "../cube.re2"

[FLUID PRESSURE]
  residualTol = 1e-05

[FLUID VELOCITY]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet, zeroDirichlet
  residualTol = 1e-08
  viscosity = -50
  density = 1.0

[SCALAR TEMPERATURE]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann, zeroNeumann
  residualTol = 1e-08
  transportCoeff = 1.0
  diffusionCoeff =  -50
