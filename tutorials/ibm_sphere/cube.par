[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 3
  numSteps = 500
  dt = 3e-2
  writeInterval = 500
  scalars = temperature

[FLUID PRESSURE]
  residualTol = 1e-05

[FLUID VELOCITY]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet, zeroDirichlet
  residualTol = 1e-08
  density = 1.0
  viscosity = -50

[SCALAR TEMPERATURE]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann, zeroNeumann
  residualTol = 1e-08
  transportCoeff = 1.0
  diffusionCoeff =  -50
