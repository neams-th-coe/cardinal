[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 5
  numSteps = 100
  dt = 1e-3
  writeInterval = 10
  scalars = temperature
  constFlowRate = meanVelocity=1.0 + direction=Z

[FLUID PRESSURE]
  residualTol = 1e-05

[FLUID VELOCITY]
  boundaryTypeMap = zeroDirichlet
  residualTol = 1e-08
  viscosity = 0.02
  density = 1.0

[SCALAR TEMPERATURE]
  solver = none
