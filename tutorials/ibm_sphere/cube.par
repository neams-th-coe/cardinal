[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 3
  numSteps = 10000
  dt = 1e-2
  writeInterval = 1000
  constFlowRate = meanVelocity=1.0 + direction=Z

[FLUID PRESSURE]
  residualTol = 1e-05

[FLUID VELOCITY]
  boundaryTypeMap = zeroDirichlet
  residualTol = 1e-08
  viscosity = 0.02
  density = 1.0
