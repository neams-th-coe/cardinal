[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 5
  numSteps = 10000
  dt = 2e-2
  writeInterval = 1000
  scalars = temperature

[FLUID PRESSURE]
  residualTol = 1e-05

[FLUID VELOCITY]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet, zeroDirichlet
  residualTol = 1e-08
  density = 1.0
  viscosity = -50

[SCALAR TEMPERATURE]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroNeumann, zeroNeumann
  residualTol = 1e-08
  transportCoeff = 1.0
  diffusionCoeff =  -50
