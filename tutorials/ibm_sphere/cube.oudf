// 3×3 inverse via adjugate/det
inline void invert3x3(const dfloat A[3][3], dfloat invA[3][3]){
  dfloat det = A[0][0]*(A[1][1]*A[2][2] - A[1][2]*A[2][1])
             - A[0][1]*(A[1][0]*A[2][2] - A[1][2]*A[2][0])
             + A[0][2]*(A[1][0]*A[2][1] - A[1][1]*A[2][0]);
  dfloat id  = 1.0/det;
  invA[0][0] =  (A[1][1]*A[2][2] - A[1][2]*A[2][1])*id;
  invA[0][1] = -(A[0][1]*A[2][2] - A[0][2]*A[2][1])*id;
  invA[0][2] =  (A[0][1]*A[1][2] - A[0][2]*A[1][1])*id;
  invA[1][0] = -(A[1][0]*A[2][2] - A[1][2]*A[2][0])*id;
  invA[1][1] =  (A[0][0]*A[2][2] - A[0][2]*A[2][0])*id;
  invA[1][2] = -(A[0][0]*A[1][2] - A[0][2]*A[1][0])*id;
  invA[2][0] =  (A[1][0]*A[2][1] - A[1][1]*A[2][0])*id;
  invA[2][1] = -(A[0][0]*A[2][1] - A[0][1]*A[2][0])*id;
  invA[2][2] =  (A[0][0]*A[1][1] - A[0][1]*A[1][0])*id;
}

// 1D weighting-bubble on [-1,1]
inline dfloat bubble1D(dfloat r, dfloat r0){
  dfloat denomPos = (1.0 - r0)*(1.0 - r0);
  dfloat denomNeg = (1.0 + r0)*(1.0 + r0);
  if (r >= r0) {
    return ((1.0 - r)*(1.0 - 2.0*r0 + r)) / denomPos;
  } else {
    return ((1.0 + r)*(1.0 + 2.0*r0 - r)) / denomNeg;
  }
}
inline dfloat bubble1D_derivative(dfloat r, dfloat r0){
  dfloat num      = 2.0*(r0 - r);
  dfloat denomPos = (1.0 - r0)*(1.0 - r0);
  dfloat denomNeg = (1.0 + r0)*(1.0 + r0);
  return (r >= r0 ? num/denomPos : num/denomNeg);
}

// Evaluate ℓ_j(xi) and ℓ_j'(xi) for j=0..p_Nq-1
inline void evalLagrange1D(const dfloat *z,
                           dlong p_Nq,
                           dfloat xi,
                           dfloat *L,
                           dfloat *dL){
  for(dlong j=0;j<p_Nq;++j){
    dfloat den = 1;
    for(dlong m=0;m<p_Nq;++m) if(m!=j) den *= (z[j]-z[m]);
    dfloat num = 1;
    for(dlong m=0;m<p_Nq;++m) if(m!=j) num *= (xi - z[m]);
    L[j] = num/den;
    dfloat sum=0;
    for(dlong m=0;m<p_Nq;++m) if(m!=j){
      dfloat prod=1;
      for(dlong n=0;n<p_Nq;++n) if(n!=j && n!=m) prod *= (xi - z[n]);
      sum += prod;
    }
    dL[j] = sum/den;
  }
}

// Evaluate lagrange for j=0..Nq-1
inline void evalLagrange1D_at(const dfloat *z,
                              const int Nq,
                              const dfloat xi,
                              dfloat *L,
                              dfloat *dL){
  for(int j=0;j<Nq;++j){
    dfloat den = 1.0;
    for(int m=0;m<Nq;++m) if(m!=j) den *= (z[j]-z[m]);

    dfloat num = 1.0;
    for(int m=0;m<Nq;++m) if(m!=j) num *= (xi - z[m]);
    L[j] = num/den;

    dfloat sum = 0.0;
    for(int m=0;m<Nq;++m) if(m!=j){
      dfloat prod = 1.0;
      for(int n=0;n<Nq;++n) if(n!=j && n!=m) prod *= (xi - z[n]);
      sum += prod;
    }
    dL[j] = sum/den;
  }
}

// vgeo accessor: vgeo[p_Nvgeo*p_Np*e + a + p_Np*id]
inline dfloat VGE(const dfloat* vgeo, const int e, const int a, const int id) {
  return vgeo[p_Nvgeo * p_Np * e + a + p_Np * id];
}

@kernel void PenaltyNoSlipBC(const dlong Nelements,
                             @restrict const dfloat* o_x,
                             @restrict const dfloat* o_y,
                             @restrict const dfloat* o_z,
                             @restrict dfloat* velocities,
                             const int offset,
                             const int fieldOffset,
                             @restrict dfloat* source,
                             const dlong numLagrangePoints,
                             @restrict const dfloat* x_s,
                             @restrict const dfloat* y_s,
                             @restrict const dfloat* z_s,
                             @restrict const dfloat* normal_x,
                             @restrict const dfloat* normal_y,
                             @restrict const dfloat* normal_z,
                             const dfloat penaltyCoefficient,
                             const dfloat dt,
                             @restrict const dfloat* Al,
                             @restrict const dfloat* Sl,
                             @restrict const int* ElementNumber,
                             const int componentIndex,
                             @restrict dfloat* o_uL,
                             @restrict const dfloat* GLL_weights, 
                             @restrict const dfloat* gllNodes,    
                             @restrict const int* elemList,       
                             @restrict const dfloat* r_x,
                             @restrict const dfloat* r_y,
                             @restrict const dfloat* r_z,
                             @restrict const dfloat* vgeo,
                             @restrict const dfloat* sdf,
                             @restrict dfloat* pressure,
                             @restrict const int* elementOffsets,
                             @restrict const int* elementLagrangeIndices,
                             @restrict dfloat* Eulerian_pressure, 
                             @restrict dfloat* uL_prev,           
                             @restrict const dfloat* D)
{
    // Polynomial order for each dimension
    int N = pow(p_Np, 1.0 / 3.0) - 1;
    
    // Parallelize over the number of Lagrange points
    for (dlong j = 0; j < numLagrangePoints; ++j; @outer(0)) {
        int eL = elemList[j]; // Element number containing this Lagrange point

        // Compute element sizes in each direction
        dfloat a_x = fabs(o_x[eL * p_Np + p_Np - 1] - o_x[eL * p_Np]);
        dfloat a_y = fabs(o_y[eL * p_Np + p_Np - 1] - o_y[eL * p_Np]);
        dfloat a_z = fabs(o_z[eL * p_Np + p_Np - 1] - o_z[eL * p_Np]);
        
         dfloat effectiveDeltaX1 = a_x/N;
         dfloat effectiveDeltaX2 = a_y/N;
         dfloat effectiveDeltaX3 = a_z/N;

        int LagrangeOffset = componentIndex * numLagrangePoints;
        dfloat uL_component = o_uL[j + LagrangeOffset] ;
        

        // Compute the force term for each Eulerian point using the interpolated Lagrange velocity
        for (dlong l = 0; l < p_Nq; ++l; @inner(0)) {
           
      
            for (dlong m = 0; m < p_Nq; ++m) {
          

                for (dlong n = 0; n < p_Nq; ++n) {
                
               
                    // Iteration over nodes per element
                    const int id = eL * p_Np + (l + m * p_Nq + n * p_Nq * p_Nq) + offset;
                    const int pd = eL * p_Np + l + m * p_Nq + n * p_Nq * p_Nq;          // Point index
        
                    dfloat dx = (o_x[pd] - x_s[j]);
                    dfloat dy = (o_y[pd] - y_s[j]);
                    dfloat dz = (o_z[pd] - z_s[j]);
                    
                    
                    dfloat distanceFactor = (D1(dx / effectiveDeltaX1) * D1(dy / effectiveDeltaX2) * D1(dz / effectiveDeltaX3)) 
                                             / (effectiveDeltaX1 * effectiveDeltaX2 * effectiveDeltaX3);
                    dfloat hL = (effectiveDeltaX1 + effectiveDeltaX2 + effectiveDeltaX3) / 3.0 ;
        
                    // Calculate the force term based on the interpolated velocity at the Lagrangian point
                    dfloat forceTerm = -uL_component / dt;
                    
                    if (sdf[pd] < 0) { //  (i had it multiplied by 0.7)
                      source[id] = -   0.7 * velocities[id] / dt; // where we have the solid part
                      
                    } else {
                      source[id] += distanceFactor * forceTerm * Al[j] * Sl[j];
                    }
                }    
            }        
        }
    }
}
    


@kernel void viscosity(const dlong Nelements, @restrict const dfloat* sdf , @restrict dfloat* property)
{
   for (dlong e = 0; e < Nelements; ++e; @outer(0))
   {
     for (int n = 0; n < p_Np; ++n; @inner(0))
     {
       const int id = e * p_Np + n;
       
       if (sdf[id] < 0) {
         property[id] = 0.5; // where we have the solid part
       } else {
         property[id] = 0.05; // 
       }
     }
   }
}

