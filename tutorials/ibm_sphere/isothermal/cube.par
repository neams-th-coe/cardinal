[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 3
  numSteps = 1000
  dt = 1e-2
  writeInterval = 1000

[MESH]
  file = "../cube.re2"

[FLUID PRESSURE]
  residualTol = 1e-05

[FLUID VELOCITY]
  boundaryTypeMap = udfDirichlet, zeroNeumann, zeroDirichlet, zeroDirichlet
  residualTol = 1e-08
  viscosity = -50.0
  density = 1.0
