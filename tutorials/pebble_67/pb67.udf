#include <math.h>
#include "udf.hpp"

#ifdef __okl__
#include "pb67.oudf"
#endif

void uservp(double time)
{
  // pass the needed info into the outlet kernel
  mesh_t *mesh = nrs->meshV;
  manipulateOutlet(mesh->Nelements, nrs->fluid->fieldOffset, nrs->scalar->fieldOffset(),
               nrs->scalar->o_S, nrs->fluid->o_prop, nrs->scalar->o_prop, mesh->o_z);
}

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
}

void UDF_Setup()
{
  auto mesh = nrs->meshV;

  // apply initial conditions: unit z-velocity
  std::vector<dfloat> U(nrs->fluid->fieldOffsetSum, 0.0);
  for (int n = 0; n < mesh->Nlocal; ++n)
    U[n + 2 * nrs->fieldOffset] = 1.0; // z-velocity
  nrs->fluid->o_U.copyFrom(U.data(), U.size());

  // set the property callback so that NekRS will modify the diffusive properties
  nrs->userProperties = &uservp;
}

void UDF_ExecuteStep(double time, int tstep)
{
  // clip temperature on each time step
  mesh_t *mesh = nrs->meshV;
  clipTemperature(mesh->Nelements, nrs->scalar->o_S);
}
