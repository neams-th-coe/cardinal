[Tests]
  [run_nek]
    type = RunApp
    input = nek.i
    requirement = "Cardinal shall be able to run NekRS and output a time history of its solution "
                  "onto a mesh mirror."
    capabilities = 'nekrs'
    min_slots = 3 # 768 MB per slot observed during https://civet.inl.gov/job/4305077/ during step Tutorials. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
  [load_nek]
    type = CSVDiff
    input = load_nek.i
    csvdiff = load_nek_out.csv
    prereq = run_nek
    requirement = "Cardinal shall be able to load a time history of a NekRS solution."
    capabilities = 'nekrs'
  []
[]
