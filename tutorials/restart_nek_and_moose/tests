[Tests]
  [create_moose_checkpoints]
    type = RunApp
    working_directory = 'create_checkpoints'
    input = 'main.i'
    requirement = "The system shall be able to create checkpoint files for a MOOSE simulation"
  []
  [read_moose_checkpoints]
    type = RunApp
    working_directory = 'create_checkpoints'
    input = 'main.i'
    requirement = "The system shall be able to read a checkpoint file in MOOSE. This is checked by evaluating the restarted field to show that the simulation picks up where it had left off in the restart case."
    prereq = 'create_moose_checkpoints'
  []
  [create_nek_checkpoints]
    type = CheckFiles
    working_directory = 'create_checkpoints'
    input = 'nek.i'
    check_files = 'pyramid0.f00000'
    requirement = "The system shall generate a NekRS output file at the expected frequency."
    capabilities = 'nekrs'
    design = 'NekRSProblem.md'
    issues = '#1345'
  []
  [read_nek_checkpoints]
    type = CSVDiff
    working_directory = 'read_from_checkpoints'
    input ='nek.i'
    csvdiff = 'nek_out.csv'
    prereq = 'create_nek_checkpoints'
    requirement = "The system shall be able to load a restart file into NekRS; this is checked by evaluating the restarted field to show that it matches the output field from the restart file."
    capabilities = 'nekrs'
    design = 'NekRSProblem.md'
    issues = '#1345'
  []
[]
