[Tests]
  [flux]
    type = RunException
    input = nek.i
    expect_err = "There are no scalars in the NekRS problem, so we failed to identify a suitable default for the 'scalar' parameter in NekBoundaryFlux."
    requirement = "MOOSE shall throw an error if there is no temperature passive scalar "
                  "variable initialized in nekRS for flux coupling."
    capabilities = 'nekrs'
    design = 'NekBoundaryFlux.md'
    issues = '#1077'
  []
  [scalar_name]
    type = RunException
    input = nek.i
    cli_args = 'Problem/casename="brick_name"'
    expect_err = "Cardinal assumes that the temperature variable is the first passive scalar, which must be named 'temperature' in the par file \(i.e. in a \[SCALAR TEMPERATURE\] block\). However, your first passive scalar is named 'other'."
    requirement = "MOOSE shall throw an error if there is no temperature passive scalar "
                  "variable initialized in nekRS based on the name not matching 'temperature'"
    capabilities = 'nekrs'
    design = 'NekBoundaryFlux.md'
    issues = '#1296'
  []
  [source]
    type = RunException
    input = source.i
    expect_err = "Cannot find 'temperature' because your Nek case files do not have a temperature variable! Cardinal assumes that the temperature variable is the first passive scalar, which must be named 'temperature' in the par file \(i.e. in a \[SCALAR TEMPERATURE\] block\). However, your par file does not have any passive scalars."
    requirement = "MOOSE shall throw an error if there is no temperature passive scalar "
                  "variable initialized in nekRS for source coupling."
    capabilities = 'nekrs'
    design = 'NekVolumetricSource.md'
    issues = '#1296'
  []
[]
