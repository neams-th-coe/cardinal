[OCCA]
  backend = CPU

[GENERAL]
  polynomialOrder = 5
  numSteps = 10
  dt = targetCFL=2.0 + initial=5e-4
  timeStepper = tombo2
  writeInterval = 5

  filtering = hpfrt
  filterWeight = 100.0
  filterModes = 2

  subCyclingSteps = 2

[PROBLEMTYPE]
  equation = navierstokes

[PRESSURE]
  residualTol = 0.0001
  maxIterations = 2000

[VELOCITY]
  boundaryTypeMap = inlet, outlet, wall
  residualTol = 1e-06
  density = 1.0
  viscosity = 1.0e-3

[TEMPERATURE]
  boundaryTypeMap = t, zeroGradient, insulated
  rhoCp = 1.0
  conductivity = 0.001
  residualTol = 1e-06
