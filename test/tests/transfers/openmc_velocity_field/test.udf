
#ifdef __okl__

#include "test.oudf"

#endif

void userSource(double time)
{
  auto mesh = nrs->meshV;
  mooseHeatSource(mesh->Nelements, nrs->scalar->fieldOffset(), platform->app->bc->o_usrwrk, nrs->scalar->o_EXT);
}

void UDF_Setup()
{
  nrs->userSource = &userSource;
  auto mesh = nrs->meshV;

  // arbitrary arrays on the host where we will fill some initial data
  std::vector<dfloat> U(nrs->fluid->fieldOffsetSum, 0.0);
  //std::vector<dfloat> P(nrs->fluid->fieldOffsetSum, 0.0);
  std::vector<dfloat> temp(mesh->Nlocal, 0.0);

  for (int n = 0; n < mesh->Nlocal; ++n)
  {
    U[n + 0 * nrs->fieldOffset] = 0.0; // x-velocity
    U[n + 1 * nrs->fieldOffset] = 0.5; // y-velocity
    U[n + 2 * nrs->fieldOffset] = 0.0; // z-velocity

    temp[n] = 922.0; // temperature
  }

  // copy host data into the device data
  nrs->fluid->o_U.copyFrom(U.data(), U.size());
  //nrs->fluid->o_P.copyFrom(P.data(), P.size());
  nrs->scalar->o_solution("temperature").copyFrom(temp.data(), temp.size());
}

void UDF_ExecuteStep(double time, int tstep)
{
}
