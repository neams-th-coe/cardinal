  [xdg_tracklength]
    type = CSVDiff
    input = xdg_multiple_meshes_global_trl.i
    csvdiff = xdg_multiple_meshes_global_trl_out.csv
    # This test has very few particles, and OpenMC will error if there aren't any particles
    # on a particular process
    max_parallel = 32
    requirement = "This test is identical to multiple_meshes_global but uses a tracklength estimator with XDG. "
                  "Results were compared to a cell tally over each fissile pebble (also using tracklength "
                  "estimators), where the integral standard deviations and mean values are identical."
    capabilities = 'xdg'
  []
