  [disallow_block_restrict]
    type = RunException
    input = block_restrict.i
    cli_args = 'Problem/Tallies/Mesh/type=XDGMeshTally'
    expect_err = "Cannot use subdomain restriction when using XDG mesh tallies!"
    requirement = "The system shall not allow block restriction with XDG mesh tallies."
    capabilities = 'openmc'
