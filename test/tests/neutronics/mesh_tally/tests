  # The remaining tests are specific to XDG mesh tallies.
  [xdg_no_mixed_elem]
    type = RunException
    input = xdg_no_mixed_elem.i
    mesh_mode = 'replicated'
    expect_err = "XDG mesh tallies only support single-element-type meshes!"
    requirement = "The system shall error if attempting to tally on mixed element meshes with XDG."
    capabilities = 'xdg'
  []
  # The remaining tests are specific to XDG mesh tallies.
  [xdg_hex_tet_only]
    type = RunException
    input = xdg_no_mixed_elem.i
    cli_args = "Mesh/mixed_elem_pin/ring_intervals=1 Mesh/delete_background/block='2'"
    mesh_mode = 'replicated'
    expect_err = "XDG mesh tallies only support TET4 and HEX8 elements!"
    requirement = "The system shall error if attempting to tally on a mesh composed of elements other than TET4 or HEX8."
    capabilities = 'xdg'
