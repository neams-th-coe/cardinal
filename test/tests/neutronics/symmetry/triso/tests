[Tests]
  design = 'SymmetryPointGenerator.md OpenMCCellAverageProblem.md'
  [generate_mesh]
    type = RunApp
    input = solid_mesh.i
    cli_args = '--mesh-only'
    requirement = "The system shall create the mesh mirror for later steps of these tests"
    capabilities = 'openmc'
  []
  [symmetry_plane]
    type = Exodiff
    input = openmc.i
    exodiff = openmc_out.e
    prereq = generate_mesh
    requirement = "The system shall correctly reflect points about a symmetry plane"
    capabilities = 'openmc'
    min_slots = 4 # 370 MB per slot observed during https://civet.inl.gov/job/4305073/ during step Test DagMC. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
[]
