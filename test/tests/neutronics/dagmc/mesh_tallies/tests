[Tests]
  issues = '#567'
  design = 'MoabSkinner.md OpenMCCellAverageProblem.md MeshTally.md'

  [csg_step_2]
    type = RunApp
    input = csg_step_2_openmc.i
    requirement = "The system shall be able to generate a CSG reference solution for the DAGMC tests "
                  "that require a reference."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
  []

  [null_skin]
    type = Exodiff
    input = one_bin.i
    exodiff = one_bin_out.e
    requirement = "The system shall give identical Monte Carlo solution (file mesh tallies and k) when skinning "
                  "as compared to both (i) a CSG-equivalent version of the geometry and (ii) the same "
                  "input file run with the skinner disabled. The CSG file used for comparison is in "
                  "the csg_step_1 directory."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
  []
  [skin]
    type = Exodiff
    input = openmc.i
    exodiff = openmc_out.e
    requirement = "The system shall give identical Monte Carlo solution within three sigma "
                  "(file mesh tallies and k) when skinning as compared to a CSG-equivalent "
                  "version of the geometry, which is in the csg_step_2 directory."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
    prereq = 'csg_step_2'
  []
  [skin_direct]
    type = Exodiff
    input = direct_tally.i
    cli_args = 'Outputs/file_base=openmc_out'
    exodiff = openmc_out.e
    requirement = "The system shall give identical Monte Carlo solution within three sigma "
                  "(direct mesh tallies and k) when skinning as compared to a CSG-equivalent "
                  "version of the geometry, which is in the csg_step_2 directory."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
    prereq = 'csg_step_2'
  []
  [disjoint_bins]
    type = Exodiff
    input = disjoint_bins.i
    exodiff = disjoint_bins_out.e
    cli_args = 'Problem/output_cell_mapping=false'
    requirement = "The system shall give identical Monte Carlo solution within three sigma "
                  "(file mesh tallies and k) when skinning as compared to a CSG-equivalent "
                  "version of the geometry, which is in the csg_step_2 directory. For this "
                  "case, a bin is split across disjoint elements."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
    prereq = 'csg_step_2'
  []
  [scale_mesh]
    type = RunApp
    input = scale.i
    cli_args = '--mesh-only'
    requirement = "The system shall scale a mesh by multiplying by 100."
  []
  [with_scaling]
    type = Exodiff
    input = with_scaling.i
    exodiff = with_scaling_out.e
    prereq = scale_mesh
    cli_args = 'Outputs/hide="cell_instance"'
    requirement = "The system shall give identical results when scaling the Mesh by an arbitrary multiplier. The gold file was compared against a case with no scaling (scaling = 1) to get identical results."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
  []
[]

[Tests]
  issues = '#1318'
  design = 'MeshTally.md OpenMCCellAverageProblem.md'

  [mesh_tally_relaxation_skin]
    type = CSVDiff
    input = with_relaxation.i
    csvdiff = with_relaxation_out.csv
    requirement = "The system shall allow for the use of relaxation with a MeshTally and a MoabSkinner."
    mesh_mode = 'replicated'
    capabilities = 'dagmc'
  []
[]
