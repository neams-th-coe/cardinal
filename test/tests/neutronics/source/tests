[Tests]
  [mesh]
    type = RunApp
    input = mesh.i
    cli_args = '--mesh-only'
    requirement = "The correct mesh shall be created for the sources test."
  []
  [sources]
    type = CheckFiles
    input = openmc.i
    prereq = mesh
    check_files = 'initial_source_0.h5 initial_source_1.h5 initial_source_2.h5'
    requirement = "The correct source files shall be created when re-using the source between iterations"
    capabilities = 'openmc'
    min_slots = 5 # 570 MB per slot observed during https://civet.inl.gov/job/4305073/ during step Test DagMC. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
[]
