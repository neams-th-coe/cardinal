[OCCA]
  backend = CPU

[GENERAL]
  stopAt = numSteps
  numSteps = 10
  dt = 0.1
  polynomialOrder = 3
  checkpointControl = steps
  checkpointInterval = 50
  scalars = temperature, other

[MESH]
  file = "../cylinders/cylinder.re2"

[FLUID VELOCITY]
  solver = none

[SCALAR TEMPERATURE]
  solver = none

[SCALAR OTHER]
  diffusionCoeff = 2.5
  transportCoeff = 1.0
  residualTol = 1.0e-10
  boundaryTypeMap = t, f, I, I
