[Tests]
  [moose]
    type = RunApp
    input = moose.i
    requirement = "The system shall run a reference MOOSE heat conduction simulation for use in assessing the same problem executed with domain decomposition in NekRS."
    min_parallel = 4

    # we only need this test for the pyramid case; the test suite would pick it up as heavy and run anyways, but
    # this prevents running in the main test suite where it's unused
    heavy = true
  []
  [pyramid]
    type = CSVDiff
    input = openmc.i
    csvdiff = openmc_csv.csv
    prereq = moose
    min_parallel = 8
    heavy = true

    # this is how we enforce that the differences should be less than 1% compared to the loaded solution
    abs_zero = 1e-2

    requirement = "A coupled MOOSE-nekRS heat conduction problem shall produce the correct temperature "
                  "distribution when (1) a heat source is applied in the nekRS volume and (2) a heat "
                  "flux is imposed in nekRS through a boundary. The test checks that temperatures match "
                  "within 1 percent from the reference MOOSE simulation which is loaded with a user object. "
    cli_args = 'Outputs/hide="max_T_int min_T_int max_T_nek min_T_nek avg_T_nek max_T_bison min_T_bison avg_T_bison pt_nek pt_bison source_bison source_nek source_integral_nek source_integral_bison flux_integral"'
    min_slots = 12 # memory heavy
    capabilities = 'nekrs'
    design = 'NekRSProblem.md NekBoundaryFlux.md NekVolumetricSource.md NekFieldVariable.md'
  []
  [pyramid_exact]
    type = CSVDiff
    input = openmc.i
    cli_args = 'MultiApps/nek/input_files="nek_exact.i" Outputs/csv=true Outputs/file_base=openmc_exact_out'
    csvdiff = openmc_exact_out.csv
    cli_args = 'Outputs/hide="source_bison source_nek source_integral_nek source_integral_bison flux_integral"'
    min_parallel = 8
    heavy = true
    rel_err = 1e-4
    requirement = "The system shall couple NekRS to MOOSE through simultaneous boundary heat flux and "
                  "volumetric heating when using an exact mesh mirror. The solution is nearly identical "
                  "to the pyramid test and the usrwrk output for flux and volumetric heating match the "
                  "auxiliary variables in the Nek-wrapped input."
    capabilities = 'nekrs'
    design = 'NekRSProblem.md NekBoundaryFlux.md NekVolumetricSource.md NekFieldVariable.md'
  []
  [duplicate_temp]
    type = RunException
    input = nek.i
    cli_args = "AuxVariables/heat_source/order=FIRST"
    expect_err = "Cardinal is trying to add an auxiliary variable named 'heat_source' through the FieldTransfer system"
    requirement = "The system shall error if the user specifies a duplicate variable with a name overlapping with special names reserved for Cardinal data transfers."
    min_slots = 6 # memory heavy
    capabilities = 'nekrs'
    design = 'NekVolumetricSource.md'
  []
[]
