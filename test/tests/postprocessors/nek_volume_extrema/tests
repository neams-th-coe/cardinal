[Tests]
  design = 'NekVolumeExtremeValue.md'
  issues = '#1046'
  [nek_volume_extrema]
    type = CSVDiff
    input = nek.i
    csvdiff = nek_out.csv
    requirement = "The system shall correctly compute max/min values of the NekRS solution fields in dimensional form. The gold file was created "
                  "by running the moose.i input, which computes the same max/min operations using "
                  "existing MOOSE postprocessors on the same mesh on auxvariables that match "
                  "the functional form of the solution fields initialized in the pyramid.udf. "
    capabilities = 'nekrs'
  []
  [nondimensional]
    type = CSVDiff
    input = nondimensional.i
    csvdiff = nondimensional_out.csv
    requirement = "The system shall correctly compute max/min values of the NekRS solution fields in nondimensional form. The values are compared to moose_nondimensional.i, which computes the same quantites in non-dimensional form which are then scaled to dimensional form to compare against the dimensionalized values."
    capabilities = 'nekrs'
  []
  [invalid_field]
    type = RunException
    input = nek.i
    cli_args = "Postprocessors/max_temp/field=velocity_component Postprocessors/max_temp/velocity_direction='1 0 0'"
    expect_err = "Setting 'field = velocity_component' is not yet implemented"
    requirement = "System shall error if using an unsupported field with a volume extrema postprocessor."
    capabilities = 'nekrs'
  []
[]
