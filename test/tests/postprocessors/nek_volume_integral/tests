[Tests]
  design = 'NekVolumeIntegral.md'
  issues = '#1065 #1345'
  requirement = 'The system shall integrate the NekRS solution over a volume. This is tested by comparing against the output files of an identical setup in MOOSE, where identical integrals are computed using existing MOOSE postprocessors on the same mesh in'

  [nek]
    type = CSVDiff
    input = nek.i
    csvdiff = nek_out.csv
    requirement = 'dimensional form'
    capabilities = 'nekrs'
  []
  [nondimensional]
    type = CSVDiff
    input = nondimensional.i
    csvdiff = nondimensional_out.csv
    requirement = 'nondimensional form'
    capabilities = 'nekrs'
  []
  [missing_field_and_function]
    type = RunException
    input = invalid.i
    expect_err = "NekVolumeIntegral requires exactly one of 'field' or 'function'."
    requirement = "The system shall report an error when neither a field nor a function is provided for volume integration."
    capabilities = 'nekrs'
  []
  [field_and_function]
    type = RunException
    input = invalid.i
    cli_args = 'Postprocessors/invalid/field=unity Postprocessors/invalid/function=unit_function'
    expect_err = "NekVolumeIntegral requires exactly one of 'field' or 'function'."
    requirement = "The system shall report an error when both a field and a function are provided for volume integration."
    capabilities = 'nekrs'
  []
  [scalar_values_no_temp]
    type = CSVDiff
    input = nek_no_temp.i
    csvdiff = nek_no_temp_out.csv
    requirement = "The system shall correctly compute integral scalar values when temperature scalars are not present. The gold file has the same data as the nek.i test but with only the scalars included."
    capabilities = 'nekrs'
  []
[]
