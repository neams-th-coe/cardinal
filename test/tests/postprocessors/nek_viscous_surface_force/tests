[Tests]
  design = 'NekViscousSurfaceForce.md'
  issues = '#1290'

  [drag]
    type = CSVDiff
    input = nek.i
    csvdiff = nek_out.csv
    requirement = "The system shall allow total viscous drag to be computed in dimensional form. This test compares drag as computed via Nek with by-hand calculations using combinations of native MOOSE postprocessors using the analytic expression for velocity."
    capabilities = 'nekrs'
    min_slots = 2 # 736 MB per slot observed during https://civet.inl.gov/job/4362038/ during step Test found in recipe file ./recipes/moosebuild/cardinal/Test_nekrs.cfg. Usage is over or within 100 MB of the total memory limit based on a 700 MB per slot limit.
  []
  [invalid_mesh]
    type = RunException
    input = nek.i
    cli_args = 'Postprocessors/viscous_x_1/mesh=all'
    expect_err = "The 'NekViscousSurfaceForce' postprocessor can only be applied to"
    requirement = "The system shall error if trying to compute viscous drag on non-fluid NekRS boundaries"
    capabilities = 'nekrs'
    min_slots = 2 # 645 MB per slot observed during https://civet.inl.gov/job/4362038/ during step Test found in recipe file ./recipes/moosebuild/cardinal/Test_nekrs.cfg. Usage is over or within 100 MB of the total memory limit based on a 700 MB per slot limit.
  []
[]
