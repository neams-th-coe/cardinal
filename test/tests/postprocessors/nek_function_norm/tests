[Tests]
  design = 'NekVolumeNorm.md'
  issues = '#1043'

  [nek_function_norm]
    type = CSVDiff
    input = nek.i
    csvdiff = nek_out.csv
    requirement = 'The system shall allow computing the integrated L-norm of a NekRS solution field relative to a MOOSE function in dimensional form. The postprocessor value is checked against a (mathematically-equivalent) NekVolumeIntegral postprocessor for the L1, L2, and Linf norms to show exact equivalence.'
    capabilities = 'nekrs'
  []
  [invalid_word_norm]
    type = RunException
    input = nek.i
    cli_args = 'Postprocessors/temp_l2/N="2blah"'
    expect_err = "Specify a finite real value N >= 1, or use 'infinity'"
    requirement = 'The system shall error if a non-numeric value is provided for the norm'
    capabilities = 'nekrs'
  []
  [negative_norm]
    type = RunException
    input = nek.i
    cli_args = 'Postprocessors/temp_l2/N="-2.1"'
    expect_err = "Norm orders must satisfy N >= 1"
    requirement = 'The system shall error if a negative value is provided for the norm'
    capabilities = 'nekrs'
  []
  [empty_norm]
    type = RunException
    input = nek.i
    cli_args = 'Postprocessors/temp_l2/N=""'
    expect_err = "Specify a finite real value N >= 1, or use 'infinity'"
    requirement = 'The system shall error if an empty value is provided for the norm'
    capabilities = 'nekrs'
  []
[]
