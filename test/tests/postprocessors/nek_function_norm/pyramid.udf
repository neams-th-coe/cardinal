{
}

void UDF_Setup()
{
  auto mesh = nrs->scalar->mesh("temperature");

  // arbitrary arrays on the host where we will fill some initial data
  std::vector<dfloat> U(nrs->fluid->fieldOffsetSum, 0.0);
  std::vector<dfloat> temp(mesh->Nlocal, 0.0);

  auto [x, y, z] = mesh->xyzHost();

  for (int n = 0; n < mesh->Nlocal; ++n)
  {
    // x-velocity is chosen to be the temperature minus the function we intend
    // to compare against for the L2 norm
    U[n + 0 * nrs->fieldOffset] =
        std::pow((exp(x[n]) + sin(y[n]) + x[n] * y[n] * z[n] -
                  (exp(x[n] * x[n]) + 0.7 * y[n] + 0.8 * z[n] + 1)),
                 2);

    // y-velocity is chosen to be the temperature minus the function we intend
    // to compare against for the L1 norm
    U[n + 1 * nrs->fieldOffset] = (exp(x[n]) + sin(y[n]) + x[n] * y[n] * z[n] -
                                   (exp(x[n] * x[n]) + 0.7 * y[n] + 0.8 * z[n] + 1));

    // temperature
    temp[n] = exp(x[n]) + sin(y[n]) + x[n] * y[n] * z[n];
  }

  // copy host data into the device data
  nrs->fluid->o_U.copyFrom(U.data(), U.size());
  nrs->scalar->o_solution("temperature").copyFrom(temp.data(), temp.size());
}

