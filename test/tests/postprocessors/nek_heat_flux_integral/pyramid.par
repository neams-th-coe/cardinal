[OCCA]
  backend = CPU

[GENERAL]
  stopAt = numSteps
  numSteps = 1
  dt = 5.0e-4
  polynomialOrder = 5
  checkpointControl = steps
  checkpointInterval = 2
  scalars = temperature, two

[FLUID VELOCITY]
  solver = none

[FLUID PRESSURE]

[SCALAR TEMPERATURE]
  solver = none
  diffusionCoeff = 25

[SCALAR TWO]
  solver = none
  diffusionCoeff = 15
