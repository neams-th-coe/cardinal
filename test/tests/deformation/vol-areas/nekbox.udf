#ifdef __okl__

#include "nekbox.oudf"

#endif

static occa::kernel mooseHeatSourceKernel;

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
  mooseHeatSourceKernel = oudfBuildKernel(kernelInfo, "mooseHeatSource");
}

void userq(double time)
{
  auto mesh = nrs->scalar->mesh("temperature");
  mooseHeatSourceKernel(
      mesh->Nelements, 0, platform->app->bc->o_usrwrk, nrs->scalar->o_EXT);
}

void UDF_Setup()
{
  auto mesh = nrs->scalar->mesh("temperature");
  std::vector<dfloat> temperature(mesh->Nlocal, 600.0);
  nrs->scalar->o_solution("temperature").copyFrom(temperature.data(), temperature.size());

  nrs->userSource = &userq;
}

void UDF_ExecuteStep(double time, int tstep)
{
}
