[GENERAL]
  polynomialOrder = 2
  stopAt = numSteps
  numSteps = 50
  dt = 2e-3
  timeStepper = tombo2
  checkpointInterval = 50
  scalars = temperature

[GEOM]
  boundaryTypeMap = zeroDirichlet, udfDirichlet, zeroDirichlet
  solver = pcg+block
  initialGuess = projection+nVector=1
  residualTol = 1e-6

[PROBLEMTYPE]
equation = navierStokes + variableViscosity

[FLUID PRESSURE]
  residualTol = 1e-4
  preconditioner = multigrid
  initialGuess = previous

[FLUID VELOCITY]
  density = 1.0
  viscosity = 0.01
  boundaryTypeMap = udfDirichlet, udfDirichlet, zeroNeumann
  residualTol = 1e-6

[SCALAR TEMPERATURE]
  solver = none
