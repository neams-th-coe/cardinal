void UDF_Setup()
{
  auto mesh = nrs->meshV;
  std::vector<dfloat> velocity(nrs->fluid->fieldOffsetSum, 0.0);
  std::vector<dfloat> pressure(mesh->Nlocal, 1.0);
  std::vector<dfloat> temperature(mesh->Nlocal, 0.0);

  nrs->fluid->o_U.copyFrom(velocity.data(), velocity.size());
  nrs->fluid->o_P.copyFrom(pressure.data(), pressure.size());
  nrs->scalar->o_solution("temperature").copyFrom(temperature.data(), temperature.size());
}

