void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity"))
  {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  }
  else if (isField("geom") && bc->id == 2)
  {
    bc->uxGeom = bc->usrwrk[1 * bc->fieldOffset + bc->idxVol];
    bc->uyGeom = bc->usrwrk[2 * bc->fieldOffset + bc->idxVol];
    bc->uzGeom = bc->usrwrk[3 * bc->fieldOffset + bc->idxVol];
  }
}
